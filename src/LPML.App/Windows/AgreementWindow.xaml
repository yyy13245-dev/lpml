<Window x:Class="LPML.App.Windows.AgreementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LPML" Width="780" Height="640" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Background="{DynamicResource Brush.Window}" CornerRadius="{DynamicResource Radius.Card}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Grid Margin="26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题行：与自绘提示窗一致 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock Text="⚖" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{DynamicResource String.Agreement.Title}" FontSize="18" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Margin="0,8,0,14" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource Brush.ForegroundMuted}"
                       Text="{DynamicResource String.Agreement.Subtitle}"/>

            <!-- 协议正文：直接复用内置 Markdown 渲染器 -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20,12">
                <FlowDocumentScrollViewer x:Name="DocViewer" Background="Transparent"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsToolBarVisible="False"
                                          IsSelectionEnabled="True"/>
            </Border>

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <TextBlock FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.ForegroundMuted}"
                           Text="{DynamicResource String.Agreement.Version}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Base}" Padding="18,8"
                            Content="{DynamicResource String.Agreement.Decline}" Click="Decline_OnClick"/>
                    <Button x:Name="AcceptButton" Style="{StaticResource Button.Primary}" Padding="20,8"
                            Margin="10,0,0,0" Content="{DynamicResource String.Agreement.Accept}" Click="Accept_OnClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
