<UserControl x:Class="LPML.App.Views.InstancesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource Font.Ui}">
    <Grid Margin="28,20,28,28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="{DynamicResource String.Instance.Title}" Style="{StaticResource Text.Title}"/>
                <TextBlock Text="{DynamicResource String.Instance.Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,16"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="InstanceList" SelectionChanged="InstanceList_OnSelectionChanged"
                             MouseDoubleClick="InstanceList_OnMouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                            Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,12,0">
                                        <TextBlock Text="🧩" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="13.5"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource Brush.ForegroundSecondary}" Margin="0,3,0,0">
                                            <Run Text="{Binding VersionId}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding LoadersText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding PlayTimeText, Mode=OneWay}" FontSize="10.5"
                                               Foreground="{DynamicResource Brush.ForegroundMuted}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource String.Instance.New}" Padding="18,9" Click="Create_OnClick"/>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Instance.Copy}" Margin="8,0,0,0" Padding="18,9" Click="Clone_OnClick"/>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Instance.Delete}" Margin="8,0,0,0" Padding="18,9" Click="Delete_OnClick"/>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Instance.OpenDir}" Margin="8,0,0,0" Padding="18,9" Click="OpenDir_OnClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 选中实例的完整设置入口 -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource String.Instance.Settings}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                        <TextBlock Text="{DynamicResource String.Instance.SettingsHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                        <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource String.Instance.OpenSettings}" Padding="20,10"
                                HorizontalAlignment="Left" Click="OpenSettings_OnClick"/>
                    </StackPanel>
                </Border>

                <!-- 新建实例 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource String.Instance.NewTitle}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource String.Instance.Name}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                        <TextBox x:Name="NewNameBox"/>
                        <TextBlock Text="{DynamicResource String.Instance.GameVersion}" Style="{StaticResource Text.Caption}" Margin="0,12,0,6"/>
                        <ComboBox x:Name="NewVersionCombo"/>
                        <CheckBox x:Name="IsolationCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Instance.Isolate}"
                                  IsChecked="True" Margin="0,14,0,0"/>
                        <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource String.Instance.Create}" Margin="0,14,0,0" Padding="20,9"
                                HorizontalAlignment="Left" Click="Create_OnClick"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
