<UserControl x:Class="LPML.App.Views.InstanceSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource Font.Ui}">
    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="208"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════ 侧边栏 ══════════ -->
        <Border Grid.Column="0" Background="{DynamicResource Brush.Card}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="16,18,16,12">
                    <TextBlock Text="{DynamicResource String.InstanceSettings.Title}" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock x:Name="SidebarInstanceName" Text="—" FontSize="11"
                               Foreground="{DynamicResource Brush.ForegroundMuted}" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <ListBox Grid.Row="1" x:Name="SectionList" Background="Transparent" BorderThickness="0"
                         Margin="8,0,8,0" SelectedIndex="0" SelectionChanged="SectionList_OnSelectionChanged">
                    <ListBoxItem Tag="overview" Padding="12,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏠" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource String.InstanceSettings.SectionOverview}" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="game" Padding="12,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎮" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource String.InstanceSettings.SectionGame}" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="folder" Padding="12,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource String.InstanceSettings.SectionFolder}" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="quick" Padding="12,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚡" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource String.InstanceSettings.SectionQuick}" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="mods" Padding="12,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧰" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource String.InstanceSettings.SectionMods}" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="isolation" Padding="12,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗂" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource String.InstanceSettings.SectionIsolation}" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="advanced" Padding="12,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛠" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource String.InstanceSettings.SectionAdvanced}" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem Tag="diagnostics" Padding="12,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🩺" FontSize="14" Margin="0,0,10,0"/>
                            <TextBlock Text="{DynamicResource String.InstanceSettings.SectionDiag}" FontSize="13"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <!-- 底部快捷操作 -->
                <StackPanel Grid.Row="2" Margin="12,8,12,14">
                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,0,0,10"/>
                    <Button Style="{StaticResource Button.Base}" Padding="12,8" Click="OpenGameDir_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource String.InstanceSettings.OpenGameDir}" FontSize="12.5"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Base}" Margin="0,7,0,0" Padding="12,8" Click="OpenInstanceDir_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗃" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource String.InstanceSettings.OpenInstanceDir}" FontSize="12.5"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="DebugLaunchButton" Style="{StaticResource Button.Primary}" Margin="0,7,0,0" Padding="12,9"
                            Click="LaunchDebug_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🐛" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock x:Name="DebugLaunchText" Text="{DynamicResource String.InstanceSettings.DebugLaunch}" FontSize="12.5"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Button.Base}" Margin="0,7,0,0" Padding="12,8" Click="LaunchNormal_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="{DynamicResource String.InstanceSettings.NormalLaunch}" FontSize="12.5"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="PrivacyHint" Text="" Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap" Margin="0,10,0,0" FontSize="10.5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════ 内容区 ══════════ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="22,18,22,22">
            <StackPanel>

                <!-- 未选择 / 未安装实例时的提示（此时下方所有选项置灰） -->
                <Border x:Name="NoInstanceNotice" Style="{StaticResource Card}" Visibility="Collapsed"
                        Background="{DynamicResource Brush.Elevated}" Margin="0,0,0,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ℹ" FontSize="15" Margin="0,0,10,0" Foreground="{DynamicResource Brush.Accent}"/>
                            <TextBlock x:Name="NoInstanceTitle" Text="{DynamicResource String.InstanceSettings.NoInstanceTitle}"
                                       FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="NoInstanceHint" Text="{DynamicResource String.InstanceSettings.NoInstanceHint}"
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                        <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource String.InstanceSettings.GoDownload}"
                                Padding="18,8" HorizontalAlignment="Left" Click="GoDownload_OnClick"/>
                    </StackPanel>
                </Border>

                <!-- ── 概览 ── -->
                <Border x:Name="PaneOverview" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource String.InstanceSettings.Overview2}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,14"/>


                        <TextBlock Text="{DynamicResource String.InstanceSettings.Name}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                        <TextBox x:Name="NameBox" Style="{StaticResource TextBox.Glass}" LostFocus="Setting_OnChanged"/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{DynamicResource String.InstanceSettings.Version}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                                <TextBox x:Name="VersionBox" Style="{StaticResource TextBox.Glass}" IsReadOnly="True"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{DynamicResource String.InstanceSettings.Loader}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                                <TextBox x:Name="LoaderBox" Style="{StaticResource TextBox.Glass}" IsReadOnly="True"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{DynamicResource String.InstanceSettings.Notes}" Style="{StaticResource Text.Caption}" Margin="0,14,0,6"/>
                        <TextBox x:Name="NotesBox" Style="{StaticResource TextBox.Glass}" Height="60"
                                 TextWrapping="Wrap" AcceptsReturn="True" LostFocus="Setting_OnChanged"/>

                        <Border Margin="0,16,0,0" Padding="14" CornerRadius="{DynamicResource Radius.Small}"
                                Background="{DynamicResource Brush.Elevated}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource String.InstanceSettings.PlayCount}" Style="{StaticResource Text.Caption}"/>
                                    <TextBlock x:Name="PlayCountText" Text="0" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{DynamicResource String.InstanceSettings.TotalTime}" Style="{StaticResource Text.Caption}"/>
                                    <TextBlock x:Name="PlayTimeText" Text="{DynamicResource String.InstanceSettings.ZeroMinutes}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{DynamicResource String.InstanceSettings.LastPlayed}" Style="{StaticResource Text.Caption}"/>
                                    <TextBlock x:Name="LastPlayedText" Text="—" FontSize="13" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── 游戏设置 ── -->
                <Border x:Name="PaneGame" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource String.InstanceSettings.GameTitle}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource String.InstanceSettings.InheritHint}" Style="{StaticResource Text.Caption}" Margin="0,0,0,14"/>

                        <CheckBox x:Name="OverrideJavaCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.InstanceSettings.OverrideJava}"
                                  Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="JavaBox" Style="{StaticResource TextBox.Glass}" LostFocus="Setting_OnChanged"/>
                            <Button Grid.Column="1" Style="{StaticResource Button.Base}" Content="{DynamicResource String.InstanceSettings.Browse}" Margin="10,0,0,0"
                                    Padding="14,7" Click="PickJava_OnClick"/>
                        </Grid>

                        <CheckBox x:Name="AutoMemoryCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.InstanceSettings.AutoMemory}"
                                  Margin="0,18,0,0" Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{DynamicResource String.InstanceSettings.MinMemory}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                                <TextBox x:Name="MinMemoryBox" Style="{StaticResource TextBox.Glass}" LostFocus="Setting_OnChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{DynamicResource String.InstanceSettings.MaxMemory}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                                <TextBox x:Name="MaxMemoryBox" Style="{StaticResource TextBox.Glass}" LostFocus="Setting_OnChanged"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{DynamicResource String.InstanceSettings.Width}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                                <TextBox x:Name="WidthBox" Style="{StaticResource TextBox.Glass}" LostFocus="Setting_OnChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{DynamicResource String.InstanceSettings.Height}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                                <TextBox x:Name="HeightBox" Style="{StaticResource TextBox.Glass}" LostFocus="Setting_OnChanged"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="FullscreenCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.InstanceSettings.Fullscreen}"
                                  Margin="0,16,0,0" Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>

                        <CheckBox x:Name="UseCustomTitleCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.InstanceSettings.CustomTitle}"
                                  Margin="0,16,0,0" Checked="UseCustomTitle_OnChanged" Unchecked="UseCustomTitle_OnChanged"/>
                        <TextBox x:Name="TitleBox" Style="{StaticResource TextBox.Glass}" Margin="0,10,0,0" LostFocus="Setting_OnChanged"/>

                        <TextBlock Text="{DynamicResource String.InstanceSettings.Server}" Style="{StaticResource Text.Caption}" Margin="0,14,0,6"/>
                        <TextBox x:Name="ServerBox" Style="{StaticResource TextBox.Glass}" LostFocus="Setting_OnChanged"/>

                        <TextBlock Text="{DynamicResource String.InstanceSettings.Priority}" Style="{StaticResource Text.Caption}" Margin="0,14,0,6"/>
                        <ComboBox x:Name="PriorityCombo" Style="{StaticResource ComboBox.Glass}"
                                  HorizontalAlignment="Left" Width="200" SelectionChanged="Setting_OnChanged">
                            <ComboBoxItem Content="{DynamicResource String.InstanceSettings.PriorityIdle}"/>
                            <ComboBoxItem Content="{DynamicResource String.InstanceSettings.PriorityBelow}"/>
                            <ComboBoxItem Content="{DynamicResource String.InstanceSettings.PriorityNormal}"/>
                            <ComboBoxItem Content="{DynamicResource String.InstanceSettings.PriorityAbove}"/>
                            <ComboBoxItem Content="{DynamicResource String.InstanceSettings.PriorityHigh}"/>
                        </ComboBox>

                        <TextBlock Text="{DynamicResource String.InstanceSettings.AfterLaunch}" Style="{StaticResource Text.Caption}" Margin="0,16,0,6"/>
                        <ComboBox x:Name="AfterLaunchCombo" Style="{StaticResource ComboBox.Glass}"
                                  HorizontalAlignment="Left" Width="240" SelectionChanged="Setting_OnChanged">
                            <ComboBoxItem Content="{DynamicResource String.InstanceSettings.AfterFollow}"/>
                            <ComboBoxItem Content="{DynamicResource String.InstanceSettings.AfterKeep}"/>
                            <ComboBoxItem Content="{DynamicResource String.InstanceSettings.AfterHide}"/>
                            <ComboBoxItem Content="{DynamicResource String.InstanceSettings.AfterExit}"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- ── 模组管理 ── -->
                <Border x:Name="PaneFolder" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource String.InstanceSettings.SectionFolder}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource String.InstanceSettings.FolderHint}"
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <!-- 当前生效目录 -->
                        <TextBlock Text="{DynamicResource String.InstanceSettings.CurrentDir}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                        <Border Padding="12" CornerRadius="{DynamicResource Radius.Small}" Background="{DynamicResource Brush.Elevated}">
                            <TextBlock x:Name="CurrentDirText" Text="—" FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <!-- 实例文件夹 -->
                        <TextBlock Text="{DynamicResource String.InstanceSettings.FolderSelect}" Style="{StaticResource Text.Caption}" Margin="0,16,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="FolderCombo" Grid.Column="0"
                                      SelectionChanged="FolderCombo_OnSelectionChanged">
    <ComboBox.ItemTemplate>
        <DataTemplate>
            <TextBlock Text="{Binding Name, Mode=OneWay}"/>
        </DataTemplate>
    </ComboBox.ItemTemplate>
</ComboBox>
                            <Button Grid.Column="1" Style="{StaticResource Button.Base}" Content="{DynamicResource String.InstanceSettings.FolderNew}"
                                    Margin="10,0,0,0" Padding="16,8" Click="NewFolder_OnClick"/>
                        </Grid>

                        <!-- 直接指定目录（优先于文件夹） -->
                        <TextBlock Text="{DynamicResource String.InstanceSettings.DirOverride}" Style="{StaticResource Text.Caption}" Margin="0,14,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DirOverrideBox" Grid.Column="0" Style="{StaticResource TextBox.Glass}" LostFocus="DirOverride_OnChanged"/>
                            <Button Grid.Column="1" Style="{StaticResource Button.Base}" Content="{DynamicResource String.InstanceSettings.DirBrowse}"
                                    Margin="10,0,0,0" Padding="16,8" Click="BrowseDir_OnClick"/>
                        </Grid>
                        <TextBlock Text="{DynamicResource String.InstanceSettings.DirOverrideHint}" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" FontSize="10.5"/>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button x:Name="InstallToFolderButton" Style="{StaticResource Button.Primary}"
                                    Content="{DynamicResource String.InstanceSettings.InstallToFolder}" Padding="18,9"
                                    Click="InstallToFolder_OnClick"/>
                        </StackPanel>
                        <TextBlock x:Name="FolderInstallStatus" Text="" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"/>

                        <!-- 该文件夹里的实例 -->
                        <TextBlock Text="{DynamicResource String.InstanceSettings.FolderInstances}" Style="{StaticResource Text.Caption}" Margin="0,16,0,6"/>
                        <ListBox x:Name="FolderInstanceList" MaxHeight="150" DisplayMemberPath="Name"/>

                        <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,18,0,14"/>

                        <TextBlock Text="{DynamicResource String.InstanceSettings.QuickActions}" Style="{StaticResource Text.Caption}" Margin="0,0,0,8"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Play.OpenGameDir}" Padding="14,7" Click="OpenGameDir_OnClick"/>
                            <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Play.OpenModsDir}" Margin="8,0,0,0" Padding="14,7" Click="OpenModsDir_OnClick"/>
                            <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Play.CheckIntegrity}" Margin="8,0,0,0" Padding="14,7" Click="Repair_OnClick"/>
                            <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Play.ViewCommand}" Margin="8,0,0,0" Padding="14,7" Click="ShowCommand_OnClick"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border x:Name="PaneQuick" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource String.InstanceSettings.SectionQuick}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource String.InstanceSettings.QuickHint}"
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <TextBlock Text="{DynamicResource String.InstanceSettings.QuickFolders}" Style="{StaticResource Text.Caption}" Margin="0,0,0,8"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.InstanceSettings.OpenGameDir}" Padding="16,8" Click="OpenGameDir_OnClick"/>
                            <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.InstanceSettings.OpenModsDir}" Margin="10,0,0,0" Padding="16,8" Click="OpenModsDir_OnClick"/>
                            <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.InstanceSettings.OpenSavesDir}" Margin="10,0,0,0" Padding="16,8" Click="OpenSavesDir_OnClick"/>
                        </WrapPanel>

                        <TextBlock Text="{DynamicResource String.InstanceSettings.QuickActions}" Style="{StaticResource Text.Caption}" Margin="0,18,0,8"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.InstanceSettings.CompleteFiles}" Padding="16,8" Click="CompleteFiles_OnClick"/>
                            <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.InstanceSettings.CheckIntegrity}" Margin="10,0,0,0" Padding="16,8" Click="CheckIntegrity_OnClick"/>
                            <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.InstanceSettings.CopyCommand}" Margin="10,0,0,0" Padding="16,8" Click="CopyCommand_OnClick"/>
                        </WrapPanel>

                        <Border Margin="0,18,0,0" Padding="14" CornerRadius="{DynamicResource Radius.Small}"
                                Background="{DynamicResource Brush.Elevated}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String.InstanceSettings.QuickLaunch}" Style="{StaticResource Text.Caption}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="QuickLaunchNormal" Style="{StaticResource Button.Primary}"
                                            Content="{DynamicResource String.InstanceSettings.LaunchNormal}" Padding="18,9" Click="QuickLaunchNormal_OnClick"/>
                                    <Button x:Name="QuickLaunchDebug" Style="{StaticResource Button.Base}"
                                            Content="{DynamicResource String.InstanceSettings.LaunchDebug}" Margin="10,0,0,0" Padding="18,9" Click="QuickLaunchDebug_OnClick"/>
                                </StackPanel>
                                <TextBlock x:Name="QuickLaunchStatus" Text="" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Border x:Name="PaneMods" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource String.InstanceSettings.ModsTitle}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                        <TextBlock x:Name="ModSummaryText" Text="" Style="{StaticResource Text.Caption}" Margin="0,0,0,12"/>

                        <ListBox x:Name="ModList" MaxHeight="330" SelectionChanged="ModList_OnSelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center" Margin="0,0,10,0"
                                                  Checked="ToggleMod_OnChecked" Unchecked="ToggleMod_OnUnchecked"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource Brush.ForegroundSecondary}">
                                                <Run Text="{Binding Loader}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding Version}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding FileName}" FontSize="10"
                                                   Foreground="{DynamicResource Brush.ForegroundMuted}"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.InstanceSettings.Refresh}" Padding="16,8" Click="RefreshMods_OnClick"/>
                            <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.InstanceSettings.AddMod}" Margin="8,0,0,0" Padding="16,8" Click="AddMods_OnClick"/>
                            <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.InstanceSettings.OpenDir}" Margin="8,0,0,0" Padding="16,8" Click="OpenModsDir_OnClick"/>
                            <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource String.Mod.DownloadMods}" Margin="8,0,0,0" Padding="16,8" Click="DownloadMods_OnClick"/>
                            <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.InstanceSettings.Delete}" Margin="8,0,0,0" Padding="16,8" Click="DeleteMod_OnClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── 版本隔离 ── -->
                <Border x:Name="PaneIsolation" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource String.InstanceSettings.IsolationTitle}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource String.InstanceSettings.IsolationHint}"
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <CheckBox x:Name="IsolationCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.InstanceSettings.EnableIsolation}"
                                  Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>

                        <TextBlock Text="{DynamicResource String.InstanceSettings.IsolationMode}" Style="{StaticResource Text.Caption}" Margin="0,14,0,6"/>
                        <ComboBox x:Name="IsolationModeCombo" SelectionChanged="Setting_OnChanged">
                            <ComboBoxItem Content="{DynamicResource String.InstanceSettings.IsolationModeFollow}" Tag="Follow"/>
                            <ComboBoxItem Content="{DynamicResource String.Settings.IsolationUserData}" Tag="UserData"/>
                            <ComboBoxItem Content="{DynamicResource String.Settings.IsolationFull}" Tag="Full"/>
                        </ComboBox>
                        <TextBlock Text="{DynamicResource String.InstanceSettings.IsolationModeHint}" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" FontSize="10.5"/>
                        <Button Style="{StaticResource Button.Base}" Margin="0,10,0,0" Padding="16,8" HorizontalAlignment="Left"
                                Content="{DynamicResource String.InstanceSettings.MigrateIsolation}" Click="MigrateIsolation_OnClick"/>

                        <TextBlock Text="{DynamicResource String.InstanceSettings.ShareHint}"
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,18,0,10"/>
                        <CheckBox x:Name="ShareModsCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.InstanceSettings.ShareMods}"
                                  Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                        <CheckBox x:Name="ShareSavesCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.InstanceSettings.ShareSaves}" Margin="0,10,0,0"
                                  Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                        <CheckBox x:Name="ShareConfigCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.InstanceSettings.ShareConfig}" Margin="0,10,0,0"
                                  Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                        <CheckBox x:Name="ShareResourcePacksCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.InstanceSettings.ShareResourcePacks}" Margin="0,10,0,0"
                                  Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                        <CheckBox x:Name="ShareShaderPacksCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.InstanceSettings.ShareShaderPacks}" Margin="0,10,0,0"
                                  Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>

                        <Border Margin="0,18,0,0" Padding="14" CornerRadius="{DynamicResource Radius.Small}"
                                Background="{DynamicResource Brush.Elevated}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{DynamicResource String.InstanceSettings.WorkingDir}" Style="{StaticResource Text.Caption}"/>
                                    <TextBlock x:Name="WorkingDirText" Text="—" FontSize="12" Margin="0,4,0,0"
                                               TextWrapping="Wrap" FontFamily="{DynamicResource Font.Mono}"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource Button.Base}" Content="{DynamicResource String.InstanceSettings.Open}" Margin="12,0,0,0"
                                        Padding="14,7" Click="OpenGameDir_OnClick"/>
                            </Grid>
                        </Border>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.InstanceSettings.ApplyIsolation}" Margin="0,12,0,0" Padding="16,8"
                                HorizontalAlignment="Left" Click="ApplyIsolation_OnClick"/>
                    </StackPanel>
                </Border>

                <!-- ── 高级参数 ── -->
                <Border x:Name="PaneAdvanced" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource String.InstanceSettings.AdvancedTitle}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource String.InstanceSettings.AdvancedHint}"
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <TextBlock Text="{DynamicResource String.InstanceSettings.JvmArgs}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                        <TextBox x:Name="JvmArgsBox" Style="{StaticResource TextBox.Glass}" Height="70"
                                 TextWrapping="Wrap" AcceptsReturn="True" LostFocus="Setting_OnChanged"/>

                        <TextBlock Text="{DynamicResource String.InstanceSettings.GameArgs}" Style="{StaticResource Text.Caption}" Margin="0,14,0,6"/>
                        <TextBox x:Name="GameArgsBox" Style="{StaticResource TextBox.Glass}" Height="60"
                                 TextWrapping="Wrap" AcceptsReturn="True" LostFocus="Setting_OnChanged"/>

                        <TextBlock Text="{DynamicResource String.InstanceSettings.EnvVars}" Style="{StaticResource Text.Caption}" Margin="0,14,0,6"/>
                        <TextBox x:Name="EnvBox" Style="{StaticResource TextBox.Glass}" Height="70"
                                 TextWrapping="Wrap" AcceptsReturn="True" LostFocus="Setting_OnChanged"/>

                        <TextBlock Text="{DynamicResource String.InstanceSettings.PreLaunch}" Style="{StaticResource Text.Caption}" Margin="0,14,0,6"/>
                        <TextBox x:Name="PreLaunchBox" Style="{StaticResource TextBox.Glass}" Height="46"
                                 TextWrapping="Wrap" AcceptsReturn="True" LostFocus="Setting_OnChanged"/>
                        <TextBlock Text="{DynamicResource String.InstanceSettings.PreLaunchHint}"
                                   Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"/>

                        <CheckBox x:Name="IsolatedNativesCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.InstanceSettings.IsolatedNatives}" Margin="0,16,0,0"
                                  Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.InstanceSettings.ViewCommand}" Padding="16,8" Click="ViewCommand_OnClick"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── 诊断与文件 ── -->
                <Border x:Name="PaneDiagnostics" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource String.InstanceSettings.DiagTitle}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource String.InstanceSettings.CompleteHint}"
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource String.InstanceSettings.CompleteFiles}" Padding="18,9" Click="CompleteFiles_OnClick"/>
                            <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.InstanceSettings.CheckIntegrity}" Margin="10,0,0,0" Padding="16,9" Click="CheckIntegrity_OnClick"/>
                        </StackPanel>

                        <TextBlock x:Name="VerifyStatusText" Text="" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,12,0,0"/>

                        <Border Margin="0,18,0,0" Padding="14" CornerRadius="{DynamicResource Radius.Small}"
                                Background="{DynamicResource Brush.Elevated}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String.InstanceSettings.LastLaunch}" Style="{StaticResource Text.Caption}"/>
                                <TextBlock x:Name="LastLaunchText" Text="—" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.InstanceSettings.OpenLogDir}" Padding="16,8" Click="OpenLogDir_OnClick"/>
                            <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.InstanceSettings.OpenCrashDir}" Margin="10,0,0,0" Padding="16,8" Click="OpenCrashDir_OnClick"/>
                            <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.InstanceSettings.OpenLauncherLog}" Margin="10,0,0,0" Padding="16,8" Click="OpenLauncherLog_OnClick"/>
                        </StackPanel>

                        <CheckBox x:Name="InstanceLogMonitorCheck" Style="{StaticResource Switch}"
                                  Content="{DynamicResource String.InstanceSettings.MonitorLog}" Margin="0,18,0,0"
                                  Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                        <TextBlock Text="{DynamicResource String.InstanceSettings.MonitorGlobalHint}"
                                   Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
