<UserControl x:Class="LPML.App.Views.DownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LPML.App.Views"
             xmlns:controls="clr-namespace:LPML.App.Controls"
             FontFamily="{DynamicResource Font.Ui}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28">
            <TextBlock Text="{DynamicResource String.Download.Title}" Style="{StaticResource Text.Title}"/>
            <TextBlock Text="{DynamicResource String.Download.Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,18"/>

            <Grid>
                <!-- 安装游戏 -->
                <StackPanel x:Name="PaneInstall" Margin="0,16,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource String.Download.Type}" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource Text.Caption}"/>
                                        <ComboBox x:Name="VersionTypeCombo" Width="150" SelectionChanged="VersionTypeCombo_OnSelectionChanged">
                                            <ComboBoxItem Content="{DynamicResource String.Download.Release}" IsSelected="True"/>
                                            <ComboBoxItem Content="{DynamicResource String.Download.Snapshot}"/>
                                            <ComboBoxItem Content="{DynamicResource String.Download.AprilFools}"/>
                                            <ComboBoxItem Content="{DynamicResource String.Download.Legacy}"/>
                                            <ComboBoxItem Content="{DynamicResource String.Download.All}"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBox Grid.Column="1" x:Name="SearchBox" Margin="16,0,0,0" TextChanged="SearchBox_OnTextChanged"/>
                                </Grid>

                                <ListBox x:Name="VersionList" Margin="0,16,0,0" Height="280" SelectionMode="Single"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling"
                                         MouseDoubleClick="VersionList_OnDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Id, Mode=OneWay}" FontWeight="SemiBold" FontSize="13.5"/>
                                                    <TextBlock Text="{Binding ReleaseTime, Mode=OneWay}" FontSize="11"
                                                               Foreground="{DynamicResource Brush.ForegroundMuted}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding TypeText, Mode=OneWay}" FontSize="11" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock x:Name="VersionStatusText" Text="{DynamicResource String.Download.LoadingVersions}"
                                           Style="{StaticResource Text.Caption}" Margin="0,12,0,0" TextWrapping="Wrap"/>

                                <TextBlock Text="{DynamicResource String.Download.ClickHint}" Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap" Margin="0,14,0,0"/>
                                <TextBlock Text="{DynamicResource String.Download.UnstableHint}" Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- 整合包 -->
                <StackPanel x:Name="PaneModpack" Margin="0,16,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String.Download.ModpackHint}" Style="{StaticResource Text.Subtitle}"/>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="PackPathBox" IsReadOnly="True"/>
                                    <Button Grid.Column="1" Style="{StaticResource Button.Base}" Content="{DynamicResource String.Download.ChooseFile}" Margin="10,0,0,0" Click="PickPack_OnClick"/>
                                </Grid>
                                <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource String.Download.ImportModpack}" Margin="0,14,0,0"
                                        HorizontalAlignment="Left" Padding="24,10" Click="ImportPack_OnClick"/>
                            </StackPanel>
                        </Border>

                        <!-- 在线获取：从 Modrinth 搜整合包并直接装成新实例 -->
                        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String.Download.OnlineModpack}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="{DynamicResource String.Download.OnlineModpackHint}" Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap" Margin="0,4,0,14"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="PackSearchBox" Style="{StaticResource TextBox.Glass}"/>
                                    <Button Grid.Column="1" Style="{StaticResource Button.Base}" Margin="10,0,0,0" Padding="20,8"
                                            Content="{DynamicResource String.Content.Search}" Click="SearchPack_OnClick"/>
                                </Grid>

                                <ListBox x:Name="PackList" Height="240" Margin="0,14,0,0"
                                         MouseDoubleClick="PackList_OnDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,2">
                                                <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="{Binding SummaryText, Mode=OneWay}" Style="{DynamicResource Text.Caption}"
                                                           TextTrimming="CharacterEllipsis" FontSize="11"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <TextBlock Text="{DynamicResource String.Download.ClickHint}" Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap" Margin="0,14,0,0"/>
                                <TextBlock x:Name="PackStatusText" Text="" Style="{StaticResource Text.Caption}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
