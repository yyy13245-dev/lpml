<Window x:Class="LPML.App.Windows.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LPML" MinHeight="200" MaxHeight="620" Width="460"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" SizeToContent="Height">
    <Border Background="{DynamicResource Brush.Window}" CornerRadius="{DynamicResource Radius.Card}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题行：图标 + 标题 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal">
                <TextBlock x:Name="IconText" Text="ℹ" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="TitleText" Text="LPML" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- 正文：可滚动，长提示也能看全 -->
            <ScrollViewer Grid.Row="1" Margin="0,14,0,0" MaxHeight="380"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText" Text="" FontSize="13.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.ForegroundSecondary}" LineHeight="21"/>
            </ScrollViewer>

            <!-- 按钮 -->
            <StackPanel Grid.Row="2" x:Name="ButtonPanel" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="NoButton" Style="{StaticResource Button.Base}" Padding="18,8"
                        Content="{DynamicResource String.Common.No}" Visibility="Collapsed" Click="No_OnClick"/>
                <Button x:Name="OkButton" Style="{StaticResource Button.Primary}" Padding="20,8"
                        Margin="10,0,0,0" Content="{DynamicResource String.Common.Ok}" Click="Ok_OnClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
