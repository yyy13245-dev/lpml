<UserControl x:Class="LPML.App.Views.FoldersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource Font.Ui}">
    <Grid Margin="28,20,28,28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="1.1*"/>
        </Grid.ColumnDefinitions>

        <!-- 左：文件夹列表。文件夹决定实例，而不是实例决定文件夹 -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="{DynamicResource String.Folder.Title}" Style="{StaticResource Text.Title}"/>
                <TextBlock Text="{DynamicResource String.Folder.Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,16"/>
            </StackPanel>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ListBox x:Name="FolderList" SelectionChanged="FolderList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                            Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,12,0">
                                        <TextBlock Text="📁" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="13.5"/>
                                        <TextBlock Text="{Binding PathText, Mode=OneWay}" FontSize="11"
                                                   Foreground="{DynamicResource Brush.ForegroundSecondary}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Mark, Mode=OneWay}" FontSize="10.5"
                                               Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource String.InstanceSettings.FolderNew}"
                                Padding="16,9" Click="NewFolder_OnClick"/>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Folder.Delete}"
                                Margin="8,0,0,0" Padding="16,9" Click="DeleteFolder_OnClick"/>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Folder.OpenDir}"
                                Margin="8,0,0,0" Padding="16,9" Click="OpenDir_OnClick"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 右：选中文件夹的详情 -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{DynamicResource String.Folder.DetailTitle}" Style="{StaticResource Text.Title}" Margin="0,0,0,16"/>

            <Border Grid.Row="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DetailTitle" Text="—" FontWeight="SemiBold" FontSize="16"/>
                            <Border x:Name="CurrentBadge" Padding="8,3" Margin="10,0,0,0" CornerRadius="4"
                                    Background="{DynamicResource Brush.AccentSoft}" Visibility="Collapsed">
                                <TextBlock Text="{DynamicResource String.Folder.Current}" FontSize="10.5"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource String.Folder.PathLabel}" Style="{StaticResource Text.Caption}" Margin="0,16,0,6"/>
                        <Border Padding="12" CornerRadius="{DynamicResource Radius.Small}" Background="{DynamicResource Brush.Elevated}">
                            <TextBlock x:Name="DetailPath" Text="—" FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <Button x:Name="SetCurrentButton" Style="{StaticResource Button.Primary}"
                                Content="{DynamicResource String.Folder.SetCurrent}" Padding="18,9" Margin="0,16,0,0"
                                HorizontalAlignment="Left" Click="SetCurrent_OnClick"/>

                        <TextBlock x:Name="InstanceCountText" Text="" Style="{StaticResource Text.Caption}" Margin="0,20,0,6"/>
                        <ListBox x:Name="DetailInstanceList" MaxHeight="170">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="{Binding VersionId, Mode=OneWay}" FontSize="11"
                                                   Foreground="{DynamicResource Brush.ForegroundMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock x:Name="VersionCountText" Text="" Style="{StaticResource Text.Caption}" Margin="0,16,0,6"/>

                        <Button x:Name="InstallToFolderButton" Style="{StaticResource Button.Base}"
                                Content="{DynamicResource String.InstanceSettings.InstallToFolder}" Padding="18,9"
                                Margin="0,16,0,0" HorizontalAlignment="Left" Click="InstallToFolder_OnClick"/>
                        <TextBlock x:Name="StatusText" Text="" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
