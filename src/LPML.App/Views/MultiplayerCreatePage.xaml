<UserControl x:Class="LPML.App.Views.MultiplayerCreatePage"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:LPML.App.Views"
                 xmlns:controls="clr-namespace:LPML.App.Controls"
                 FontFamily="{DynamicResource Font.Ui}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="28,20,28,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- 左：第一步 启动实例 -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="1" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource String.Multi.StepLaunch}" Style="{StaticResource Text.Subtitle}"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource String.Multi.StepLaunchHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <controls:InstancePickerControl x:Name="Picker"/>

                    <Border x:Name="LaunchStatusBorder" Margin="0,14,0,0" Visibility="Collapsed" Padding="12" CornerRadius="{DynamicResource Radius.Small}"
                            Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="LaunchStatusText" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:Name="LaunchStatusDetail" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource Brush.ForegroundMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 右：第二步 填写共享地址并生成房间号 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="2" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource String.Multi.StepAddress}" Style="{StaticResource Text.Subtitle}"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource String.Multi.StepAddressHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <TextBlock Text="{DynamicResource String.Multi.LocalShareIp}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                    <TextBox x:Name="AddressBox" Margin="0,0,0,12" TextChanged="AddressBox_OnTextChanged"/>

                    <TextBlock Text="{DynamicResource String.Multi.Port}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="PortBox" InputScope="Digits" TextChanged="AddressBox_OnTextChanged"/>
                        <Button Grid.Column="2" Style="{StaticResource Button.Base}" Content="{DynamicResource String.Multi.FillDetected}" Padding="14,8" Click="FillDetected_OnClick"/>
                    </Grid>

                    <CheckBox x:Name="ManualCheck" Content="{DynamicResource String.Multi.UseManual}" IsChecked="False" Margin="0,0,0,16" Checked="ManualCheck_OnChecked" Unchecked="ManualCheck_OnChecked"/>

                    <Button Style="{StaticResource Button.Primary}" x:Name="GenerateButton" Content="{DynamicResource String.Multi.GenerateRoom}" Padding="22,10" Click="Generate_OnClick"/>
                    <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Multi.Back}" Margin="0,10,0,0" Padding="22,9" Click="Back_OnClick"/>

                    <Border x:Name="ResultBorder" Margin="0,18,0,0" Visibility="Collapsed" Padding="14" CornerRadius="{DynamicResource Radius.Small}"
                            Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String.Multi.RoomCodeLabel}" FontSize="11" Foreground="{DynamicResource Brush.ForegroundMuted}"/>
                            <Grid Margin="0,6,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="RoomCodeText" FontSize="26" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource Button.Base}" Content="{DynamicResource String.Multi.Copy}" Margin="10,0,0,0" Padding="14,8" Click="Copy_OnClick"/>
                            </Grid>
                            <TextBlock x:Name="ResultAddressText" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Text="{DynamicResource String.Multi.RoomShareHint}" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource Brush.ForegroundMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
