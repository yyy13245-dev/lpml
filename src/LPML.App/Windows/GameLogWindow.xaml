<Window x:Class="LPML.App.Windows.GameLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="LPML Log" Height="640" Width="940" MinHeight="360" MinWidth="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" SnapsToDevicePixels="True"
        FontFamily="{DynamicResource Font.Ui}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border CornerRadius="14" Background="{DynamicResource Brush.Window}" ClipToBounds="True"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Border Width="16" Height="16" CornerRadius="5" Background="{DynamicResource Brush.Accent}" Margin="0,0,9,0"/>
                    <TextBlock x:Name="TitleText" Text="{DynamicResource String.GameLog.Title}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource Brush.Foreground}"/>
                    <Border x:Name="RunningBadge" Margin="10,0,0,0" Padding="8,2" CornerRadius="{DynamicResource Radius.Pill}"
                            Background="{DynamicResource Brush.AccentSoft}" Visibility="Collapsed">
                        <TextBlock x:Name="RunningBadgeText" Text="{DynamicResource String.GameLog.Running}" FontSize="10.5"
                                   Foreground="{DynamicResource Brush.Accent}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button Style="{StaticResource Button.Icon}" Content="—" Click="Minimize_OnClick" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource Button.Icon}" Content="□" Click="Maximize_OnClick" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource Button.Icon}" Content="✕" Click="Close_OnClick" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                </StackPanel>
            </Grid>

            <!-- 工具栏 -->
            <Border Grid.Row="1" Padding="12,8" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{DynamicResource String.GameLog.Level}" Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <ComboBox Grid.Column="1" x:Name="LevelCombo" Style="{StaticResource ComboBox.Glass}"
                              SelectedIndex="0" SelectionChanged="LevelCombo_OnSelectionChanged">
                        <ComboBoxItem Content="{DynamicResource String.GameLog.LevelAll}"/>
                        <ComboBoxItem Content="{DynamicResource String.GameLog.LevelInfo}"/>
                        <ComboBoxItem Content="{DynamicResource String.GameLog.LevelWarn}"/>
                        <ComboBoxItem Content="{DynamicResource String.GameLog.LevelError}"/>
                        <ComboBoxItem Content="{DynamicResource String.GameLog.LevelFatal}"/>
                    </ComboBox>

                    <TextBox Grid.Column="2" x:Name="SearchBox" Style="{StaticResource TextBox.Glass}"
                             Margin="12,0,0,0" TextChanged="SearchBox_OnTextChanged"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0">
                        <CheckBox x:Name="AutoScrollCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.GameLog.AutoScroll}"
                                  IsChecked="True" VerticalAlignment="Center" Margin="0,0,14,0"
                                  Checked="AutoScrollCheck_OnChanged" Unchecked="AutoScrollCheck_OnChanged"/>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.GameLog.Clear}" Padding="14,6" Click="Clear_OnClick"/>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.GameLog.Export}" Margin="8,0,0,0" Padding="14,6" Click="Export_OnClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 日志列表 -->
            <ListBox Grid.Row="2" x:Name="LogList" Background="Transparent" BorderThickness="0"
                     FontFamily="{DynamicResource Font.Mono}" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     SelectionChanged="LogList_OnSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource Brush.ForegroundMuted}"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding LevelText}" Width="52" FontWeight="SemiBold"
                                       Foreground="{Binding LevelBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding ThreadText}" Foreground="{DynamicResource Brush.ForegroundSecondary}"
                                       Width="120" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Message}" Foreground="{Binding LevelBrush}" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{DynamicResource String.GameLog.CopyLine}" Click="CopyLine_OnClick"/>
                        <MenuItem Header="{DynamicResource String.GameLog.CopyAll}" Click="CopyAll_OnClick"/>
                    </ContextMenu>
                </ListBox.ContextMenu>
            </ListBox>

            <!-- 状态栏 -->
            <Border Grid.Row="3" Padding="12,7" Background="{DynamicResource Brush.Card}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="StatusText" Text="" Style="{StaticResource Text.Caption}"/>
                    <TextBlock Grid.Column="1" x:Name="PortText" Text="" Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.Accent}"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
