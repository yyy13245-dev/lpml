<UserControl x:Class="LPML.App.Views.MultiplayerPage"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:LPML.App.Views"
                 FontFamily="{DynamicResource Font.Ui}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28">
            <TextBlock Text="{DynamicResource String.Multi.Title}" Style="{StaticResource Text.Title}"/>
            <TextBlock Text="{DynamicResource String.Multi.Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,18"/>

            <!-- 1. 联机核心：下载/状态 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String.Multi.CoreTitle}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource String.Multi.CoreSubtitle}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" x:Name="CoreDot" Width="10" Height="10" CornerRadius="5" Background="{DynamicResource Brush.ForegroundMuted}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="CoreStatusText" Text="{DynamicResource String.Multi.StatusUnknown}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock x:Name="CoreVersionText" Text="" FontSize="11" Foreground="{DynamicResource Brush.ForegroundMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Base}" x:Name="CoreConfigureButton" Content="{DynamicResource String.Multi.Configure}" Margin="0,0,8,0" Padding="16,8" Click="CoreConfigure_OnClick"/>
                            <Button Style="{StaticResource Button.Primary}" x:Name="CoreActionButton" Content="{DynamicResource String.Multi.DownloadCore}" Padding="18,8" Click="CoreAction_OnClick"/>
                        </StackPanel>
                    </Grid>

                    <Border x:Name="CoreProgressBorder" Margin="0,14,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="CoreProgressBar" Height="8" Value="0"/>
                            <TextBlock Grid.Column="1" x:Name="CoreProgressText" Margin="10,0,0,0" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Brush.ForegroundMuted}"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="CoreErrorText" Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource Brush.ForegroundMuted}" TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <!-- 2. 创建房间 / 加入房间（只选入口，不堆叠下一步） -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String.Multi.ActionTitle}" Style="{StaticResource Text.Subtitle}" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource String.Multi.ActionSubtitle}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Background="{DynamicResource Brush.Window}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String.Multi.CreateRoom}" Style="{StaticResource Text.Subtitle}"/>
                                <TextBlock Text="{DynamicResource String.Multi.CreateRoomHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                                <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource String.Multi.GoCreate}" HorizontalAlignment="Left" Padding="22,9" Click="GoCreate_OnClick"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Background="{DynamicResource Brush.Window}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String.Multi.JoinRoom}" Style="{StaticResource Text.Subtitle}"/>
                                <TextBlock Text="{DynamicResource String.Multi.JoinRoomHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                                <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource String.Multi.GoJoin}" HorizontalAlignment="Left" Padding="22,9" Click="GoJoin_OnClick"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="{DynamicResource String.Multi.LocalOnlyNote}" Style="{StaticResource Text.Caption}" Margin="2,14,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
