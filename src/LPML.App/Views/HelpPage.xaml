<UserControl x:Class="LPML.App.Views.HelpPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题栏（列表页与内容页共用，返回按钮仅在内容页显示） -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" x:Name="BackButton" Style="{StaticResource Button.Base}"
                    Padding="14,7" Margin="0,0,12,0" Visibility="Collapsed"
                    Content="{DynamicResource String.Help.Back}" Click="Back_OnClick"/>

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="HeadTitle" Text="{DynamicResource String.Help.Title}" Style="{StaticResource Text.Title}"/>
                <TextBlock x:Name="HeadSubtitle" Text="{DynamicResource String.Help.Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="2" x:Name="ToolPanel" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource Button.Base}" Padding="14,7" Margin="0,0,10,0"
                        Content="{DynamicResource String.Help.OpenExternal}" Click="OpenExternal_OnClick"/>
                <Button Style="{StaticResource Button.Base}" Padding="14,7"
                        Content="{DynamicResource String.Help.OpenFolder}" Click="OpenFolder_OnClick"/>
            </StackPanel>
        </Grid>

        <!-- 文档列表 -->
        <ScrollViewer Grid.Row="1" x:Name="ListView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="CategoryList" ItemsSource="{Binding}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,22">
                            <!-- 分类标题 -->
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                                <TextBlock Text="{Binding Icon}" FontSize="17" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TitleNow}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- 该分类下的文档 -->
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Button.Base}" HorizontalContentAlignment="Stretch"
                                                Margin="0,0,0,10" Padding="20,16" Click="Document_OnClick" Tag="{Binding Id}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding IconNow}" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TitleNow}" FontSize="15" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding SummaryNow}" Style="{StaticResource Text.Subtitle}" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="›" FontSize="22" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Brush.ForegroundSecondary}" Margin="12,0,0,0"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 文档内容（点进条目后才显示） -->
        <Grid Grid.Row="1" x:Name="DocumentView" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Padding="26,20">
                <FlowDocumentScrollViewer x:Name="DocViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsToolBarVisible="False"
                                          IsSelectionEnabled="True"/>
            </Border>
            <!-- 解析中提示：解析很快，通常看不到，但慢机器上不会白屏 -->
            <Border x:Name="LoadingMask" Style="{StaticResource Card}" Padding="26,20">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource String.Help.Parsing}" FontSize="15" HorizontalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Height="4" Width="220" Margin="0,14,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
