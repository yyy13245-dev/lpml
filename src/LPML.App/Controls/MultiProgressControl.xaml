<UserControl x:Class="LPML.App.Controls.MultiProgressControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LPML.App.Controls"
             xmlns:core="clr-namespace:LPML.Core.Download;assembly=LPML.Core">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type core:DownloadItem}">
            <Border Background="{DynamicResource Brush.Card}" CornerRadius="{DynamicResource Radius.Small}"
                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="12,9" Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name, Mode=OneWay}" FontSize="12.5"
                               TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.Foreground}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StatusText, Mode=OneWay}" FontSize="11"
                               Foreground="{DynamicResource Brush.ForegroundMuted}" Margin="12,0,0,0"/>

                    <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Height="6" Margin="0,7,0,0"
                                 Value="{Binding Progress, Mode=OneWay}" Maximum="1" Minimum="0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding ProgressText, Mode=OneWay}" FontSize="11" Margin="0,5,0,0"
                               Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SpeedText, Mode=OneWay}" FontSize="11" Margin="12,5,0,0"
                               Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 汇总进度 -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Card}" CornerRadius="{DynamicResource Radius.Card}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="SummaryText" Text="{DynamicResource String.Progress.Summary}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Foreground}"/>
                    <TextBlock x:Name="PercentText" HorizontalAlignment="Right" Text="0%" FontSize="13"
                               Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
                </Grid>
                <ProgressBar x:Name="TotalBar" Height="12" Margin="0,10,0,0" Minimum="0" Maximum="1" Value="0"/>
                <Grid Margin="0,8,0,0">
                    <TextBlock x:Name="DetailText" Text="" FontSize="11.5" Foreground="{DynamicResource Brush.ForegroundMuted}"/>
                    <TextBlock x:Name="ActiveCountText" HorizontalAlignment="Right" FontSize="11.5"
                               Foreground="{DynamicResource Brush.ForegroundMuted}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- 逐项进度（多进度条） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ItemList"
                          ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType={x:Type local:MultiProgressControl}}}"/>
        </ScrollViewer>
    </Grid>
</UserControl>
