<UserControl x:Class="LPML.App.Views.ModsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource Font.Ui}">
    <UserControl.Resources>
        <!-- 右键菜单沿用现有画刷，避免系统浅色菜单和深色界面打架 -->
        <Style x:Key="ModContextMenu" TargetType="ContextMenu">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{DynamicResource Brush.Elevated}"
                                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Small}" Padding="4"
                                Effect="{DynamicResource Effect.Float}">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Foreground}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="12,8">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.CardHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,20,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource String.Mod.Title}" Style="{StaticResource Text.Title}"/>
            <TextBlock Text="{DynamicResource String.Mod.Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,16"/>

            <!-- 勾选任意一行的小勾后出现 -->
            <Border x:Name="MultiBar" Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MultiCountText" Grid.Column="0" VerticalAlignment="Center"
                               Style="{StaticResource Text.Caption}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="SelectAllButton" Style="{StaticResource Button.Base}" Padding="14,7"
                                Content="{DynamicResource String.Mod.SelectAll}" Click="SelectAll_OnClick"/>
                        <Button Style="{StaticResource Button.Base}" Margin="8,0,0,0" Padding="14,7"
                                Content="{DynamicResource String.Mod.BatchEnable}" Click="BatchEnable_OnClick"/>
                        <Button Style="{StaticResource Button.Base}" Margin="8,0,0,0" Padding="14,7"
                                Content="{DynamicResource String.Mod.BatchDisable}" Click="BatchDisable_OnClick"/>
                        <Button Style="{StaticResource Button.Base}" Margin="8,0,0,0" Padding="14,7"
                                Content="{DynamicResource String.Mod.BatchDelete}" Click="BatchDelete_OnClick"/>
                        <Button Style="{StaticResource Button.Primary}" Margin="8,0,0,0" Padding="14,7"
                                Content="{DynamicResource String.Mod.CancelMulti}" Click="CancelMulti_OnClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource String.Mod.Instance}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="InstanceCombo" DisplayMemberPath="Name" SelectionChanged="InstanceCombo_OnSelectionChanged"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" x:Name="ModsDirText" VerticalAlignment="Bottom" Margin="16,0,0,4"
                               FontSize="11.5" Foreground="{DynamicResource Brush.ForegroundMuted}" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Mod.Refresh}" Padding="16,8" Click="Refresh_OnClick"/>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Mod.Add}" Margin="8,0,0,0" Padding="16,8" Click="AddMod_OnClick"/>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Mod.OpenDir}" Margin="8,0,0,0" Padding="16,8" Click="OpenDir_OnClick"/>
                        <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource String.Mod.DownloadMods}" Margin="8,0,0,0" Padding="16,8" Click="DownloadMods_OnClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="ModList" ContextMenuOpening="ModList_OnContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu Style="{StaticResource ModContextMenu}">
                            <MenuItem x:Name="ContextDeleteItem" Style="{StaticResource ModMenuItem}"
                                      Header="{DynamicResource String.Mod.ContextDelete}"
                                      Click="ContextDelete_OnClick"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=OneWay}"
                                          VerticalAlignment="Center" Checked="ModToggle_OnChanged" Unchecked="ModToggle_OnChanged"
                                          Tag="{Binding}"/>
                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" FontSize="13.5"/>
                                    <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource Brush.ForegroundSecondary}"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource Brush.ForegroundMuted}" Margin="0,3,0,0">
                                        <Run Text="{Binding Loader}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding Version}"/>
                                        <Run Text=" · "/>
                                        <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"
                                              ToolTip="{DynamicResource String.Mod.SelectTip}"
                                              Checked="ModSelect_OnChanged" Unchecked="ModSelect_OnChanged" Tag="{Binding}"/>
                                    <Button Content="{DynamicResource String.Mod.Delete}" Style="{StaticResource Button.Base}" Padding="14,6"
                                            Margin="12,0,0,0" Tag="{Binding}" Click="DeleteMod_OnClick"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="1" x:Name="SummaryText" Margin="0,12,0,0" Style="{StaticResource Text.Caption}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
