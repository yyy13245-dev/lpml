<Window x:Class="LPML.App.Windows.LaunchProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource String.Launch.Title}" Height="430" Width="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True">
    <Border Background="{DynamicResource Brush.Window}" CornerRadius="{DynamicResource Radius.Card}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Grid Margin="26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <StackPanel Grid.Row="0">
                <TextBlock Text="{DynamicResource String.Launch.Title}" FontWeight="SemiBold" FontSize="18"/>
                <TextBlock x:Name="VersionText" Text="—" Style="{DynamicResource Text.Caption}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 五个阶段 -->
            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <StackPanel x:Name="Stage1" Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock x:Name="Icon1" Text="○" FontSize="15" Width="24" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource String.Launch.Stage1}" FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="Detail1" Text="" Style="{DynamicResource Text.Caption}" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="Stage2" Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock x:Name="Icon2" Text="○" FontSize="15" Width="24" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource String.Launch.Stage2}" FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="Detail2" Text="" Style="{DynamicResource Text.Caption}" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="Stage3" Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock x:Name="Icon3" Text="○" FontSize="15" Width="24" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource String.Launch.Stage3}" FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="Detail3" Text="" Style="{DynamicResource Text.Caption}" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="Stage4" Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock x:Name="Icon4" Text="○" FontSize="15" Width="24" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource String.Launch.Stage4}" FontSize="13.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="Detail4" Text="" Style="{DynamicResource Text.Caption}" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- 依赖下载进度（仅第 1 阶段用到） -->
                <ProgressBar x:Name="DepBar" Height="5" Margin="26,0,0,0" Value="0" Maximum="1" Visibility="Collapsed"/>
                <TextBlock x:Name="DepSpeed" Text="" Style="{DynamicResource Text.Caption}" FontSize="11"
                           Margin="26,6,0,0" Visibility="Collapsed"/>

                <!-- 游戏日志尾部（启动中阶段） -->
                <Border x:Name="LogBox" Margin="26,6,0,0" Padding="10" CornerRadius="{DynamicResource Radius.Small}"
                        Background="{DynamicResource Brush.Elevated}" Visibility="Collapsed">
                    <TextBlock x:Name="LogTail" Text="" FontSize="10.5" FontFamily="Consolas"
                               TextWrapping="Wrap" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
                </Border>
            </StackPanel>

            <!-- 取消 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource Button.Base}" Padding="18,8"
                        Content="{DynamicResource String.Msg.Common.Cancel}" Click="Cancel_OnClick"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
