<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- 基础画刷（运行时由 ThemeService 按主题 / 强调色 / 毛玻璃不透明度动态改写） -->
    <SolidColorBrush x:Key="Brush.Window" Color="#FF14141A"/>
    <SolidColorBrush x:Key="Brush.Glass" Color="#B31E1E28"/>
    <SolidColorBrush x:Key="Brush.Card" Color="#992A2A36"/>
    <SolidColorBrush x:Key="Brush.CardHover" Color="#B8333342"/>
    <SolidColorBrush x:Key="Brush.CardPressed" Color="#CC3D3D4E"/>
    <SolidColorBrush x:Key="Brush.Elevated" Color="#CC33333F"/>
    <SolidColorBrush x:Key="Brush.Foreground" Color="#FFF2F2F8"/>
    <SolidColorBrush x:Key="Brush.ForegroundSecondary" Color="#FFA9A9BC"/>
    <SolidColorBrush x:Key="Brush.ForegroundMuted" Color="#FF7C7C90"/>
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF7C6BFF"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#337C6BFF"/>
    <SolidColorBrush x:Key="Brush.AccentForeground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#2AFFFFFF"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#3DFFFFFF"/>
    <SolidColorBrush x:Key="Brush.Success" Color="#FF4ADE80"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFFB923C"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFF87171"/>
    <SolidColorBrush x:Key="Brush.Track" Color="#33FFFFFF"/>

    <Color x:Key="Color.Accent">#FF7C6BFF</Color>

    <!-- 动效缩放量：由 ThemeService 按"拉伸动效 / 动效开关"动态改写 -->
    <sys:Double x:Key="Scale.Hover">1.018</sys:Double>
    <sys:Double x:Key="Scale.Press">1.06</sys:Double>

    <CornerRadius x:Key="Radius.Card">14</CornerRadius>
    <CornerRadius x:Key="Radius.Small">8</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <Thickness x:Key="Padding.Card">16</Thickness>
    <Thickness x:Key="Padding.Page">24</Thickness>

    <DropShadowEffect x:Key="Effect.Card" BlurRadius="24" ShadowDepth="0" Opacity="0.28" Color="#000000"/>
    <DropShadowEffect x:Key="Effect.Float" BlurRadius="40" ShadowDepth="0" Opacity="0.35" Color="#000000"/>

    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI, Microsoft YaHei, 微软雅黑</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Sarasa Mono SC, 等线</FontFamily>
</ResourceDictionary>
