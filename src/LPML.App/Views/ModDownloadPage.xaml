<UserControl x:Class="LPML.App.Views.ModDownloadPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource Font.Ui}">
    <Grid Margin="28,20,28,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{DynamicResource String.ModDownload.Title}" Style="{StaticResource Text.Title}"/>
            <TextBlock Text="{DynamicResource String.ModDownload.Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,16"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource String.ModDownload.Instance}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <ComboBox x:Name="InstanceCombo" DisplayMemberPath="Name" SelectionChanged="InstanceCombo_OnChanged"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" x:Name="TargetDirText" VerticalAlignment="Bottom" Margin="16,0,0,4"
                                   FontSize="11.5" Foreground="{DynamicResource Brush.ForegroundMuted}" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource String.ModDownload.InstanceHint}" Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap" Margin="0,8,0,0"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="SearchBox" Style="{StaticResource TextBox.Glass}"
                                 KeyDown="SearchBox_OnKeyDown"/>
                        <Button Grid.Column="1" Style="{StaticResource Button.Base}" Margin="10,0,0,0" Padding="22,8"
                                Content="{DynamicResource String.ModDownload.Search}" Click="Search_OnClick"/>
                    </Grid>
                    <CheckBox x:Name="MatchInstanceCheck" Style="{StaticResource Switch}" Margin="0,12,0,0"
                              IsChecked="True" Content="{DynamicResource String.ModDownload.MatchInstance}"
                              Checked="MatchInstance_OnChanged" Unchecked="MatchInstance_OnChanged"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="ResultList" SelectionChanged="ResultList_OnChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding Summary, Mode=OneWay}" FontSize="11"
                                               Foreground="{DynamicResource Brush.ForegroundSecondary}"
                                               TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Column="1" Margin="16,0,0,0">
                        <TextBlock Text="{DynamicResource String.ModDownload.Version}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="VersionCombo">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Name="VersionHintText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Margin="0,8,0,0" Text="{DynamicResource String.ModDownload.VersionHint}"/>
                        <Button x:Name="DownloadButton" Style="{StaticResource Button.Primary}" Margin="0,18,0,0"
                                HorizontalAlignment="Left" Padding="24,10"
                                Content="{DynamicResource String.ModDownload.Download}" Click="Download_OnClick"/>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.ModDownload.PrevPage}"
                            Padding="14,6" Click="PrevPage_OnClick"/>
                    <TextBlock x:Name="PageText" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Margin="12,0"/>
                    <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.ModDownload.NextPage}"
                            Padding="14,6" Click="NextPage_OnClick"/>
                </StackPanel>

                <TextBlock Grid.Row="2" x:Name="StatusText" Margin="0,8,0,0" Style="{StaticResource Text.Caption}"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
