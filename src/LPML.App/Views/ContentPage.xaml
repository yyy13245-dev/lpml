<UserControl x:Class="LPML.App.Views.ContentPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             Background="Transparent">

    <UserControl.Resources>
        <!-- 类型 Tab 的选中态按钮 -->
        <Style x:Key="TypeTabButton" TargetType="Button" BasedOn="{StaticResource Button.Base}">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="TypeTabButtonActive" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ 顶部：类型切换 + 实例选择 ══ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="TabMod" Style="{StaticResource TypeTabButtonActive}" Content="{DynamicResource String.Content.Type.Mod}" Click="TypeTab_OnClick" Tag="0"/>
                <Button x:Name="TabResourcePack" Style="{StaticResource TypeTabButton}" Content="{DynamicResource String.Content.Type.ResourcePack}" Click="TypeTab_OnClick" Tag="1"/>
                <Button x:Name="TabShader" Style="{StaticResource TypeTabButton}" Content="{DynamicResource String.Content.Type.Shader}" Click="TypeTab_OnClick" Tag="2"/>
                <Button x:Name="TabModpack" Style="{StaticResource TypeTabButton}" Content="{DynamicResource String.Content.Type.Modpack}" Click="TypeTab_OnClick" Tag="3"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource String.Content.TargetInstance}" Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="InstanceCombo" Style="{StaticResource ComboBox.Glass}" Width="190" SelectionChanged="InstanceCombo_OnChanged">
    <ComboBox.ItemTemplate>
        <DataTemplate>
            <TextBlock Text="{Binding Name, Mode=OneWay}"/>
        </DataTemplate>
    </ComboBox.ItemTemplate>
</ComboBox>
            </StackPanel>
        </Grid>

        <!-- ══ 搜索与筛选 ══ -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="SearchBox" Style="{StaticResource TextBox.Glass}"
                         KeyDown="SearchBox_OnKeyDown"/>
                <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Content="{DynamicResource String.Content.Search}"
                        Margin="10,0,0,0" Padding="20,8" Click="Search_OnClick"/>
                <Button Grid.Column="2" Style="{StaticResource Button.Base}" Content="{DynamicResource String.Content.OpenWeb}"
                        Margin="8,0,0,0" Padding="14,8" Click="OpenWeb_OnClick"/>
            </Grid>

            <!-- 筛选行：MC 版本 + 加载器。筛选后对应版本成为推荐 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="{DynamicResource String.Content.FilterGameVersion}" Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="GameVersionCombo" Style="{StaticResource ComboBox.Glass}" Width="130"
                          Margin="0,0,14,0" SelectionChanged="Filter_OnChanged">
    <ComboBox.ItemTemplate>
        <DataTemplate>
            <TextBlock Text="{Binding Mode=OneWay}"/>
        </DataTemplate>
    </ComboBox.ItemTemplate>
</ComboBox>
                <TextBlock Text="{DynamicResource String.Content.FilterLoader}" Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="LoaderCombo" Style="{StaticResource ComboBox.Glass}" Width="130"
                          Margin="0,0,14,0" SelectionChanged="Filter_OnChanged">
    <ComboBox.ItemTemplate>
        <DataTemplate>
            <TextBlock Text="{Binding Mode=OneWay}"/>
        </DataTemplate>
    </ComboBox.ItemTemplate>
</ComboBox>
                <CheckBox x:Name="MatchInstanceCheck" Style="{StaticResource Switch}"
                          Content="{DynamicResource String.Content.MatchInstance}" VerticalAlignment="Center"
                          Checked="MatchInstance_OnChanged" Unchecked="MatchInstance_OnChanged"/>
            </StackPanel>
        </Grid>

        <!-- ══ 主体：左列表 / 右详情 ══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1.15*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- 左：搜索结果 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="ResultCountText" Style="{StaticResource Text.Caption}" Margin="0,0,0,10"/>

                    <ListBox Grid.Row="1" x:Name="ResultList" SelectionChanged="ResultList_OnSelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="8"
                                            Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,10,0">
                                        <TextBlock Text="📦" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Description}" FontSize="10.5" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Brush.ForegroundSecondary}"
                                                   TextTrimming="CharacterEllipsis" MaxHeight="30"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding DownloadsText, Mode=OneWay}" FontSize="10"
                                                       Foreground="{DynamicResource Brush.ForegroundMuted}"/>
                                            <TextBlock Text=" ⬇" FontSize="10" Foreground="{DynamicResource Brush.ForegroundMuted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Content.PrevPage}"
                                Padding="14,6" Click="PrevPage_OnClick"/>
                        <TextBlock x:Name="PageText" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Margin="12,0"/>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Content.NextPage}"
                                Padding="14,6" Click="NextPage_OnClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 右：详情 -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="DetailTitle" Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap"/>
                    <TextBlock Grid.Row="0" x:Name="DetailEmptyHint" Style="{StaticResource Text.Caption}"
                               Text="{DynamicResource String.Content.SelectHint}" TextWrapping="Wrap" Margin="0,6,0,0"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel>
                            <!-- 光影加载器状态条（仅光影类型显示） -->
                            <Border x:Name="ShaderLoaderBar" Style="{StaticResource Card}" Padding="10" Margin="0,0,0,12"
                                    Visibility="Collapsed" Background="{DynamicResource Brush.CardHover}">
                                <StackPanel>
                                    <TextBlock x:Name="ShaderLoaderText" TextWrapping="Wrap" FontSize="12"/>
                                    <Button x:Name="ShaderLoaderAction" Style="{StaticResource Button.Primary}"
                                            Margin="0,8,0,0" Padding="14,6" HorizontalAlignment="Left"
                                            Click="ShaderLoaderAction_OnClick"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="DetailMeta" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <!-- 按 MC 版本分组的下拉框：点进去列出该 MC 版本下所有模组版本 -->
                            <TextBlock Text="{DynamicResource String.Content.GameVersionGroup}" Style="{StaticResource Text.Caption}" Margin="0,4,0,6"/>
                            <ComboBox x:Name="GameVersionGroupCombo" Style="{StaticResource ComboBox.Glass}"
                                      DisplayMemberPath="DisplayName" SelectionChanged="GameVersionGroup_OnChanged"/>

                            <TextBlock Text="{DynamicResource String.Content.VersionList}" Style="{StaticResource Text.Caption}" Margin="0,12,0,6"/>
                            <ListBox x:Name="VersionList" MaxHeight="180" SelectionChanged="VersionList_OnSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3">
                                            <TextBlock Text="{Binding Display, Mode=OneWay}" FontSize="12"/>
                                            <TextBlock Text="{Binding LoadersText, Mode=OneWay}" FontSize="10"
                                                       Foreground="{DynamicResource Brush.ForegroundMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 依赖（整合包没有依赖，会自动隐藏） -->
                            <TextBlock x:Name="DependencyLabel" Text="{DynamicResource String.Content.Dependencies}"
                                       Style="{StaticResource Text.Caption}" Margin="0,12,0,6"/>
                            <ListBox x:Name="DependencyList" MaxHeight="110" SelectionChanged="DependencyList_OnSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontSize="11.5" TextWrapping="Wrap">
                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding TypeText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="InstallButton" Style="{StaticResource Button.Primary}"
                                Content="{DynamicResource String.Content.Install}" Padding="20,8" Click="Install_OnClick"/>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Content.OpenProjectWeb}"
                                Margin="10,0,0,0" Padding="14,8" Click="OpenProjectWeb_OnClick"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
