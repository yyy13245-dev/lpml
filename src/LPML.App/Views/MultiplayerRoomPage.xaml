<UserControl x:Class="LPML.App.Views.MultiplayerRoomPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource Font.Ui}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28">
            <TextBlock x:Name="TitleText" Style="{StaticResource Text.Title}"/>
            <TextBlock x:Name="HintText" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,14" TextWrapping="Wrap"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String.Multi.Copyright}" Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.ForegroundMuted}" TextWrapping="Wrap" Margin="0,0,0,14"/>
                    <TextBlock Text="{DynamicResource String.Multi.Room.BrowserHint}" Style="{StaticResource Text.Caption}"
                               Foreground="{DynamicResource Brush.ForegroundMuted}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                    <TextBlock x:Name="StateText" FontWeight="SemiBold" FontSize="14" Margin="0,0,12,0" TextWrapping="Wrap"/>

                    <Border x:Name="CodeBorder" Margin="0,14,0,0" Padding="14" CornerRadius="{DynamicResource Radius.Small}"
                            Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String.Multi.RoomCodeLabel}" FontSize="11" Foreground="{DynamicResource Brush.ForegroundMuted}"/>
                            <Grid Margin="0,6,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="RoomCodeText" FontSize="24" FontWeight="Bold" FontFamily="Consolas" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Style="{StaticResource Button.Base}" Content="{DynamicResource String.Multi.Copy}" Margin="10,0,0,0" Padding="14,8" Click="Copy_OnClick"/>
                            </Grid>
                            <TextBlock Text="{DynamicResource String.Multi.RoomShareHint}" FontSize="11" Foreground="{DynamicResource Brush.ForegroundMuted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="UrlBorder" Margin="0,14,0,0" Padding="14" CornerRadius="{DynamicResource Radius.Small}"
                            Background="{DynamicResource Brush.Window}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String.Multi.Room.GuestUrl}" FontSize="11" Foreground="{DynamicResource Brush.ForegroundMuted}"/>
                            <TextBlock x:Name="UrlText" Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="{DynamicResource String.Multi.Room.PeersLabel}" Style="{StaticResource Text.Caption}" Margin="0,16,0,6"/>
                    <ItemsControl x:Name="PeerList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Raw}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,2,0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock x:Name="ActionHint" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="CloseButton" Style="{StaticResource Button.Primary}" Padding="22,10" Click="Close_OnClick"/>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Multi.Back}" Margin="12,0,0,0" Padding="22,9" Click="Back_OnClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
