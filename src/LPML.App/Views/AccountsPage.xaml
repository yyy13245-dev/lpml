<UserControl x:Class="LPML.App.Views.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource Font.Ui}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28">
            <TextBlock Text="{DynamicResource String.Account.Title}" Style="{StaticResource Text.Title}"/>
            <TextBlock Text="{DynamicResource String.Account.Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,18"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="StorageText" Text="" Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Account.ImportCustom}" Padding="14,7" Click="ImportCustom_OnClick"/>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Account.OpenPortable}" Margin="10,0,0,0" Padding="14,7"
                                Click="OpenStorageDir_OnClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ListBox x:Name="AccountList" Grid.Column="0" SelectionChanged="AccountList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Brush.AccentSoft}">
                                        <TextBlock Text="👤" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName, Mode=OneWay}" FontWeight="SemiBold" FontSize="13.5"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding TypeName, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
                                            <TextBlock Text=" · " FontSize="11" Foreground="{DynamicResource Brush.ForegroundMuted}"/>
                                            <TextBlock Text="{Binding StorageDisplayName, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource Brush.ForegroundMuted}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Uuid}" FontSize="10" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.ForegroundMuted}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" Width="170">
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Account.RefreshToken}" Padding="16,9" Click="RefreshToken_OnClick"/>
                        <TextBlock Text="{DynamicResource String.Account.StorageLabel}" Style="{StaticResource Text.Caption}" Margin="0,14,0,4"/>
                        <ComboBox x:Name="MoveStorageCombo" SelectedIndex="0">
                            <ComboBoxItem Content="{DynamicResource String.Account.StoragePortable}"/>
                            <ComboBoxItem Content="{DynamicResource String.Account.StorageUserProfile}"/>
                            <ComboBoxItem Content="{DynamicResource String.Account.StorageCustom}"/>
                        </ComboBox>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Account.MoveHere}" Margin="0,8,0,0" Padding="16,9" Click="MoveAccount_OnClick"/>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Account.Delete}" Margin="0,8,0,0" Padding="16,9" Click="Remove_OnClick"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock Text="{DynamicResource String.Account.AddHint}" Style="{StaticResource Text.Caption}"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
