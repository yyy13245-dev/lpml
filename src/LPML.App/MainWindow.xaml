<Window x:Class="LPML.App.MainWindow" Closing="MainWindow_OnClosing"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:LPML.App"
        xmlns:views="clr-namespace:LPML.App.Views"
        Title="LPML" Height="760" Width="1180" MinHeight="600" MinWidth="1000"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" SnapsToDevicePixels="True"
        FontFamily="{DynamicResource Font.Ui}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border CornerRadius="16" Background="{DynamicResource Brush.Window}" ClipToBounds="True">
        <Grid>
            <!-- 背景层：用户壁纸 + 模糊（毛玻璃观感） -->
            <Grid x:Name="BackgroundLayer">
                <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="0.55">
                    <Image.Effect>
                        <BlurEffect Radius="24" KernelType="Gaussian"/>
                    </Image.Effect>
                </Image>
                <Rectangle x:Name="GlassTint" Fill="{DynamicResource Brush.Glass}"/>
                <Rectangle Fill="{DynamicResource Brush.Window}" Opacity="0.35"/>
            </Grid>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题栏 -->
                <Grid Grid.Row="0" x:Name="TitleBar" Background="Transparent" MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource Brush.Accent}" Margin="0,0,10,0"/>
                        <TextBlock Text="LPML" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Brush.Foreground}"/>
                        <TextBlock Text="Launcher" Margin="6,0,0,0" FontSize="12" Foreground="{DynamicResource Brush.ForegroundMuted}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                        <Button Style="{StaticResource Button.Icon}" Content="↻" Click="Restart_OnClick" ToolTip="{DynamicResource String.Main.Restart}" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Style="{StaticResource Button.Icon}" Content="—" Click="Minimize_OnClick" ToolTip="{DynamicResource String.Main.Minimize}" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Style="{StaticResource Button.Icon}" Content="□" Click="Maximize_OnClick" ToolTip="{DynamicResource String.Main.Maximize}" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Style="{StaticResource Button.Icon}" Content="✕" Click="Close_OnClick" ToolTip="{DynamicResource String.Main.Close}" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>

                <!-- 主体：一级导航 / 二级分区（二级覆盖整页） -->
                <Grid Grid.Row="1">
                    <!-- ── 一级 ── -->
                    <Grid x:Name="Level1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="236"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource Brush.Card}" CornerRadius="16,0,0,0"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,1,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <ListBox Grid.Row="0" x:Name="NavList" Margin="10,10,10,0"
                                         SelectionChanged="NavList_OnSelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4,3">
                                                <TextBlock Text="{Binding Icon, Mode=OneWay}" FontSize="15" Width="24"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="13.5"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- 账户入口：点击后进入账户界面 -->
                                <Button Grid.Row="1" Margin="10,6,10,12" Padding="10" Cursor="Hand"
                                        Click="AccountEntry_OnClick" HorizontalContentAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Root" Background="{DynamicResource Brush.Card}" CornerRadius="{DynamicResource Radius.Small}"
                                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.CardHover}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="{DynamicResource Brush.AccentSoft}">
                                            <TextBlock x:Name="AccountAvatar" Text="👤" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="AccountName" Text="{DynamicResource String.Main.NoAccount}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock x:Name="AccountType" Text="{DynamicResource String.Main.OfflineMode}" FontSize="11" Foreground="{DynamicResource Brush.ForegroundMuted}"/>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>

                        <ContentControl x:Name="PageHost" Grid.Column="1" Margin="0"/>
                    </Grid>

                    <!-- ── 二级分区：整页覆盖，左上角返回 ── -->
                    <Grid x:Name="Level2" Visibility="Collapsed" Background="{DynamicResource Brush.Window}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="236"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource Brush.Card}"
                                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" x:Name="BackButton" Margin="12,12,12,6" Padding="12,8"
                                        Style="{StaticResource Button.Base}" HorizontalContentAlignment="Left"
                                        Click="Back_OnClick">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="←" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="BackText" Text="{DynamicResource String.Main.Back}" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                                <ListBox Grid.Row="1" x:Name="SubNavList" Margin="12,4,12,12"
                                         SelectionChanged="SubNavList_OnSelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4,3">
                                                <TextBlock Text="{Binding Icon, Mode=OneWay}" FontSize="15" Width="24"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="13.5"
                                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <ContentControl x:Name="SubPageHost" Grid.Column="1" Margin="0"/>
                    </Grid>

                    <!-- ── 任务：有下载任务时才出现 ── -->
                    <Button x:Name="TaskButton" Panel.ZIndex="1000"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,14,28,0" Padding="16,9" Style="{StaticResource Button.Base}"
                            FontSize="12.5" FontWeight="SemiBold" Visibility="Collapsed"
                            Click="TaskButton_OnClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⟳" FontSize="13" Margin="0,0,7,0"/>
                            <TextBlock x:Name="TaskButtonText" Text="{DynamicResource String.Task.Title}"/>
                        </StackPanel>
                    </Button>

                    <!-- ── 任务中心面板 ── -->
                    <Border x:Name="TaskPanel" Panel.ZIndex="1001" Visibility="Collapsed"
                            HorizontalAlignment="Right" Width="420" Margin="0,52,0,0"
                            Background="{DynamicResource Brush.Window}">
                        <views:TaskCenter x:Name="TaskCenterView"/>
                    </Border>

                    <!-- ── 结束游戏：有运行实例才出现，点开列出全部实例供选择 ── -->
                    <Border x:Name="SessionPanel" Panel.ZIndex="1002" Visibility="Collapsed"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,96"
                            Width="330" Padding="16" CornerRadius="{DynamicResource Radius.Card}"
                            Background="{DynamicResource Brush.Elevated}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                            Effect="{DynamicResource Effect.Float}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String.Main.EndGamePanel}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="{DynamicResource String.Main.EndGamePanelHint}" Style="{StaticResource Text.Caption}"
                                       TextWrapping="Wrap" Margin="0,4,0,12"/>
                            <ListBox x:Name="SessionList" MaxHeight="220" SelectionMode="Single">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,4">
                                            <TextBlock Text="{Binding InstanceName}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding DetailText}" FontSize="11"
                                                       Foreground="{DynamicResource Brush.ForegroundMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
                                <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Main.EndGameCancel}"
                                        Padding="14,7" Click="EndGameCancel_OnClick"/>
                                <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource String.Main.EndSelected}"
                                        Padding="14,7" Margin="8,0,0,0" Click="EndSelectedGame_OnClick"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ── 全局悬浮：开始游戏（始终浮在所有页面之上） ── -->
                    <StackPanel Panel.ZIndex="999" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28">
                        <Button x:Name="CloseGameButton" Visibility="Collapsed" Margin="0,0,10,0"
                                Padding="18,15" Style="{StaticResource Button.Base}"
                                FontSize="13.5" FontWeight="SemiBold" Click="CloseGameButton_OnClick"
                                Content="{DynamicResource String.Main.EndGame}"/>
                        <Button x:Name="StartGameButton" Padding="30,15" Style="{StaticResource Button.Primary}"
                                FontSize="14.5" FontWeight="SemiBold" Click="StartGame_OnClick"
                                Effect="{DynamicResource Effect.Float}"
                                Content="{DynamicResource String.Main.StartGame}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
