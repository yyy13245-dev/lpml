<UserControl x:Class="LPML.App.Views.PlayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LPML.App.Views"
             FontFamily="{DynamicResource Font.Ui}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28">
            <TextBlock Text="{DynamicResource String.Play.Title}" Style="{StaticResource Text.Title}"/>
            <TextBlock Text="{DynamicResource String.Play.Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,20"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- 主卡片 -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="56" Height="56" CornerRadius="16" Background="{DynamicResource Brush.AccentSoft}">
                                <TextBlock Text="🎮" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="InstanceNameText" Text="{DynamicResource String.Play.NoInstance}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="InstanceDetailText" Text="{DynamicResource String.Play.CreateInstanceFirst}" FontSize="12"
                                           Foreground="{DynamicResource Brush.ForegroundSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource String.Play.Instance}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                                <ComboBox x:Name="InstanceCombo" SelectionChanged="InstanceCombo_OnSelectionChanged"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name, Mode=OneWay}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,22,0,18"/>

                        <!-- 一键静音：按下直接把 options.txt 里的音量写成 0 -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                                <TextBlock Text="{DynamicResource String.Play.MuteButton}" FontSize="13"/>
                                <TextBlock Text="{DynamicResource String.Play.MuteButtonHint}" Style="{StaticResource Text.Caption}"
                                           FontSize="10.5" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="MuteButton" Style="{StaticResource Button.Base}"
                                    VerticalAlignment="Center" Padding="18,8" Content="{DynamicResource String.Play.MuteAction}"
                                    Click="MuteButton_OnClick"/>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusText" Text="{DynamicResource String.Play.Ready}" FontSize="13"/>
                                <ProgressBar x:Name="LaunchProgress" Height="6" Margin="0,8,60,0" Value="0" Maximum="1"
                                             Visibility="Collapsed"/>
                            </StackPanel>
                            <Button Grid.Column="1" x:Name="LaunchButton" Style="{StaticResource Button.Primary}"
                                    Content="{DynamicResource String.Play.Launch}" FontSize="16" Padding="34,14" Click="LaunchButton_OnClick"
                                    HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 侧栏：快捷信息 -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String.Play.Runtime}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource String.Play.GameDir}" Style="{StaticResource Text.Caption}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="GameDirText" Text=".minecraft" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Java" Style="{StaticResource Text.Caption}" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="JavaText" Text="{DynamicResource String.Play.Detecting}" FontSize="11.5" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource String.Play.Mirror}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="MirrorText" Text="BMCLAPI" FontSize="11.5" Margin="0,10,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
