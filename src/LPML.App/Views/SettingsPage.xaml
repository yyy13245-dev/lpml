<UserControl x:Class="LPML.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource Font.Ui}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28">
            <TextBlock Text="{DynamicResource String.Settings.Title}" Style="{StaticResource Text.Title}"/>
            <TextBlock Text="{DynamicResource String.Settings.Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,18"/>

            <!-- 下载源 -->
            <Expander Header="{DynamicResource String.Settings.GroupMirror}" Style="{StaticResource SettingsGroup}" Tag="mirror">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource String.Settings.GlobalDefault}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="DefaultMirrorCombo" SelectionChanged="Setting_OnChanged" HorizontalAlignment="Left" Width="260">
                            <ComboBoxItem Content="{DynamicResource String.Settings.MirrorOfficial}" Tag="0"/>
                            <ComboBoxItem Content="BMCLAPI" Tag="1"/>
                            <ComboBoxItem Content="{DynamicResource String.Mirror.FastMCMirror}" Tag="3"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="{DynamicResource String.Settings.PerCategoryHint}" Style="{StaticResource Text.Caption}" Margin="0,16,0,8"/>
                    <StackPanel x:Name="MirrorCategoryPanel"/>
                    <CheckBox x:Name="AutoFastestCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.AutoFastest}"
                              Margin="0,10,0,0" Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <TextBlock Text="{DynamicResource String.Settings.CustomBaseHint}" Style="{StaticResource Text.Caption}" Margin="0,16,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="BMCLAPI" VerticalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                        <TextBox Grid.Column="1" x:Name="BmclapiBaseBox" LostFocus="Setting_OnChanged"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource String.Mirror.FastMCMirror}" VerticalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                        <TextBox Grid.Column="1" x:Name="FastMCMirrorBaseBox" LostFocus="Setting_OnChanged"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource String.Settings.FastMCMirrorHint}" Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11"/>
                    <TextBlock Text="{DynamicResource String.Settings.BmclapiCredit}" Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11"/>
                </StackPanel>
            </Expander>

            <!-- 下载 -->
            <Expander Header="{DynamicResource String.Settings.GroupDownload}" Style="{StaticResource SettingsGroup}" Tag="download">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource String.Settings.MaxConcurrent}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="ConcurrentBox" LostFocus="Setting_OnChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource String.Settings.MaxChunks}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="ChunksBox" LostFocus="Setting_OnChanged"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource String.Settings.ChunkThreshold}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="ChunkThresholdBox" LostFocus="Setting_OnChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource String.Settings.RetryCount}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="RetryBox" LostFocus="Setting_OnChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- 一轮结束后把失败文件整体重新排队，不用逐个点重试 -->
                    <CheckBox x:Name="AutoRetryRoundCheck" Style="{StaticResource Switch}" Margin="0,14,0,0"
                              Content="{DynamicResource String.Settings.AutoRetryBatch}"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <TextBlock Text="{DynamicResource String.Settings.AutoRetryBatchHint}" Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap" Margin="0,4,0,0" FontSize="10.5"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource String.Settings.AutoRetryRounds}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="AutoRetryRoundsBox" LostFocus="Setting_OnChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource String.Settings.AutoRetryDelay}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="AutoRetryDelayBox" LostFocus="Setting_OnChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- 渐进启动：别一瞬间把几十个连接全部建立起来 -->
                    <CheckBox x:Name="RampUpCheck" Style="{StaticResource Switch}" Margin="0,12,0,0"
                              Content="{DynamicResource String.Settings.RampUp}"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <TextBlock Text="{DynamicResource String.Settings.RampUpHint}" Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap" Margin="0,4,0,0" FontSize="10.5"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource String.Settings.RampUpStart}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="RampUpStartBox" LostFocus="Setting_OnChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource String.Settings.RampUpInterval}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="RampUpIntervalBox" LostFocus="Setting_OnChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- 按文件大小自适应并发：小文件多开、大文件收窄 -->
                    <CheckBox x:Name="SizeAwareCheck" Style="{StaticResource Switch}" Margin="0,14,0,0"
                              Content="{DynamicResource String.Settings.SizeAware}"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <TextBlock Text="{DynamicResource String.Settings.SizeAwareHint}" Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap" Margin="0,4,0,0" FontSize="10.5"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource String.Settings.SmallFileConcurrency}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="SmallFileConcurrencyBox" LostFocus="Setting_OnChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource String.Settings.LargeFileConcurrency}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="LargeFileConcurrencyBox" LostFocus="Setting_OnChanged"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock Text="{DynamicResource String.Settings.LargeFileThreshold}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                        <TextBox x:Name="LargeFileThresholdBox" LostFocus="Setting_OnChanged" Width="140" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <!-- 旧配置可能还是保守值，一键套用推荐参数 -->
                    <Button Style="{StaticResource Button.Base}" Margin="0,14,0,0" Padding="16,8"
                            HorizontalAlignment="Left" Content="{DynamicResource String.Settings.ApplyFast}"
                            Click="ApplyFastDownload_OnClick"/>
                    <TextBlock x:Name="FastHintText" Text="{DynamicResource String.Settings.ApplyFastHint}"
                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="10.5"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource String.Settings.SpeedLimit}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="SpeedLimitBox" LostFocus="Setting_OnChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource String.Settings.Timeout}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TimeoutBox" LostFocus="Setting_OnChanged"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="VerifySha1Check" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.VerifySha1}" Margin="0,14,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <CheckBox x:Name="SkipExistingCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.SkipExisting}" Margin="0,10,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <CheckBox x:Name="RangeFallbackCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.RangeFallback}" Margin="0,10,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <CheckBox x:Name="UseProxyCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.UseProxy}" Margin="0,14,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <TextBox x:Name="ProxyBox" Margin="0,8,0,0" LostFocus="Setting_OnChanged"/>
                </StackPanel>
            </Expander>

            <!-- 临时文件 -->
            <Expander Header="{DynamicResource String.Settings.GroupTemp}" Style="{StaticResource SettingsGroup}" Tag="temp">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String.Settings.TempMode}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="TempModeCombo" SelectionChanged="Setting_OnChanged" HorizontalAlignment="Left" Width="300">
                        <ComboBoxItem Content="{DynamicResource String.Settings.TempNever}" Tag="0"/>
                        <ComboBoxItem Content="{DynamicResource String.Settings.TempSmallOnly}" Tag="1"/>
                        <ComboBoxItem Content="{DynamicResource String.Settings.TempAlways}" Tag="2"/>
                    </ComboBox>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource String.Settings.TempTotalLimit}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TempLimitBox" LostFocus="Setting_OnChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource String.Settings.TempFileLimit}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="TempFileLimitBox" LostFocus="Setting_OnChanged"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="ClearTempCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.ClearTempOnExit}" Margin="0,14,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <CheckBox x:Name="ClearLocalTempCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.ClearLocalTempOnExit}" Margin="0,10,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource String.Settings.CacheLimit}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="CacheLimitBox" LostFocus="Setting_OnChanged"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Button.Base}" Content="{DynamicResource String.Settings.ClearCacheNow}" VerticalAlignment="Bottom"
                                Margin="12,0,0,0" Padding="16,8" Click="ClearCache_OnClick"/>
                    </Grid>
                    <TextBlock x:Name="TempStatusText" Text="" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>

            <!-- 路径 -->
            <Expander Header="{DynamicResource String.Settings.GroupPaths}" Style="{StaticResource SettingsGroup}" Tag="paths">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String.Settings.GameDirHint}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="GameDirBox" LostFocus="Setting_OnChanged"/>
                        <Button Grid.Column="1" Style="{StaticResource Button.Base}" Content="{DynamicResource String.Settings.BrowseGame}" Margin="10,0,0,0" Padding="16,8" Click="BrowseGameDir_OnClick"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource String.Settings.CacheDirHint}" Style="{StaticResource Text.Caption}" Margin="0,12,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="CacheDirBox" LostFocus="Setting_OnChanged"/>
                        <Button Grid.Column="1" Style="{StaticResource Button.Base}" Content="{DynamicResource String.Settings.BrowseCache}" Margin="10,0,0,0" Padding="16,8" Click="BrowseCacheDir_OnClick"/>
                    </Grid>
                    <CheckBox x:Name="IsolationCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.InstanceIsolation}" Margin="0,14,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <!-- 隔离模式：仅用户数据（省空间） / 完整隔离（方便迁移） -->
                    <TextBlock Text="{DynamicResource String.Settings.IsolationMode}" Style="{StaticResource Text.Caption}" Margin="0,14,0,6"/>
                    <ComboBox x:Name="IsolationModeCombo" SelectionChanged="IsolationMode_OnChanged">
                        <ComboBoxItem Content="{DynamicResource String.Settings.IsolationUserData}" Tag="UserData"/>
                        <ComboBoxItem Content="{DynamicResource String.Settings.IsolationFull}" Tag="Full"/>
                    </ComboBox>
                    <TextBlock Text="{DynamicResource String.Settings.IsolationModeHint}" Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap" Margin="0,4,0,0" FontSize="10.5"/>
                    <Button Style="{StaticResource Button.Base}" Margin="0,10,0,0" Padding="16,8" HorizontalAlignment="Left"
                            Content="{DynamicResource String.Settings.MigrateIsolation}" Click="MigrateIsolation_OnClick"/>
                    <TextBlock Text="{DynamicResource String.Settings.MigrateIsolationHint}" Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap" Margin="0,4,0,0" FontSize="10.5"/>
                    <CheckBox x:Name="OfficialProfilesCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.WriteOfficialProfiles}" Margin="0,10,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <TextBlock x:Name="RootDirText" Text="" Style="{StaticResource Text.Caption}" Margin="0,12,0,0"/>
                </StackPanel>
            </Expander>

            <!-- 账户 -->
            <Expander Header="{DynamicResource String.Settings.GroupAccount}" Style="{StaticResource SettingsGroup}" Tag="account">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String.Settings.AccountDefaultHint}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="AccountStorageCombo" SelectionChanged="Setting_OnChanged" HorizontalAlignment="Left" Width="420">
                        <ComboBoxItem Content="{DynamicResource String.Settings.AccountPortable}"/>
                        <ComboBoxItem Content="{DynamicResource String.Settings.AccountUserProfile}"/>
                        <ComboBoxItem Content="{DynamicResource String.Settings.AccountCustom}"/>
                    </ComboBox>

                    <TextBlock Text="{DynamicResource String.Settings.AccountCustomHint}" Style="{StaticResource Text.Caption}" Margin="0,14,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="AccountCustomDirBox" LostFocus="Setting_OnChanged"/>
                        <Button Grid.Column="1" Style="{StaticResource Button.Base}" Content="{DynamicResource String.Settings.BrowseAccount}" Margin="10,0,0,0" Padding="16,8"
                                Click="BrowseAccountDir_OnClick"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Settings.ImportDir}" Padding="16,8" Click="ImportAccountDir_OnClick"/>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Settings.UnimportDir}" Margin="10,0,0,0" Padding="16,8" Click="UnimportAccountDir_OnClick"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource String.Settings.ImportedDirs}" Style="{StaticResource Text.Caption}" Margin="0,14,0,6"/>
                    <ListBox x:Name="ImportedDirList" MaxHeight="110" SelectionChanged="ImportedDirList_OnSelectionChanged"/>

                    <CheckBox x:Name="AutoOpenBrowserCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.AutoOpenBrowser}" Margin="0,14,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Settings.OpenPortableAccount}" Padding="16,8" Click="OpenAccountDir_OnClick"/>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Settings.MoveAllAccounts}" Margin="10,0,0,0" Padding="16,8"
                                Click="MoveAllAccounts_OnClick"/>
                    </StackPanel>
                    <TextBlock x:Name="AccountStorageText" Text="" Style="{StaticResource Text.Caption}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>

            <!-- Java -->
            <Expander Header="{DynamicResource String.Settings.GroupJava}" Style="{StaticResource SettingsGroup}" Tag="java">
                <StackPanel>
                    <!-- ══ Java 列表 ══ -->
                    <TextBlock Text="{DynamicResource String.Java.ListTitle}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                    <TextBlock Text="{DynamicResource String.Java.ListHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListBox x:Name="JavaList" Grid.Row="0" MaxHeight="230" SelectionChanged="JavaList_OnSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                                    Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,10,0">
                                                <TextBlock Text="☕" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" FontSize="12.5">
                                                    <Run Text="{Binding TypeText, Mode=OneWay}" Foreground="{DynamicResource Brush.Accent}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding ListName, Mode=OneWay}"/>
                                                    <Run Text="  "/>
                                                    <Run Text="{Binding SourceText, Mode=OneWay}" Foreground="{DynamicResource Brush.ForegroundMuted}" FontSize="10.5"/>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Detail, Mode=OneWay}" FontSize="10.5" Margin="0,2,0,0"
                                                           Foreground="{DynamicResource Brush.ForegroundSecondary}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding StatusText, Mode=OneWay}" FontSize="10.5"
                                                       Foreground="{DynamicResource Brush.ForegroundMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource Button.Primary}" Content="{DynamicResource String.Java.Add}" Padding="14,7" Click="AddJava_OnClick"/>
                                <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Java.ScanSystem}" Margin="8,0,0,0" Padding="14,7" Click="ScanJava_OnClick"/>
                                <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Java.SyncPath}" Margin="8,0,0,0" Padding="14,7" Click="SyncPathJava_OnClick"/>
                                <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Java.Validate}" Margin="8,0,0,0" Padding="14,7" Click="ValidateJava_OnClick"/>
                                <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Java.Remove}" Margin="8,0,0,0" Padding="14,7" Click="RemoveJava_OnClick"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 选中项的操作 -->
                    <TextBlock x:Name="JavaSelectionLabel" Text="{DynamicResource String.Java.NoneSelected}" Style="{StaticResource Text.Caption}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="JavaNicknameBox" LostFocus="JavaNickname_OnLostFocus"/>
                        <Button Grid.Column="1" Style="{StaticResource Button.Base}" Content="{DynamicResource String.Java.Pin}" Margin="10,0,0,0" Padding="14,7" Click="PinJava_OnClick"/>
                    </Grid>

                    <!-- 选择策略 -->
                    <TextBlock Text="{DynamicResource String.Java.Mode}" Style="{StaticResource Text.Caption}" Margin="0,14,0,6"/>
                    <ComboBox x:Name="JavaModeCombo" SelectionChanged="JavaMode_OnChanged" HorizontalAlignment="Left" Width="280">
                        <ComboBoxItem Content="{DynamicResource String.Java.ModeAuto}"/>
                        <ComboBoxItem Content="{DynamicResource String.Java.ModeManual}"/>
                    </ComboBox>
                    <TextBlock x:Name="JavaModeHint" Text="" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"/>

                    <!-- JDK / JRE 偏好 -->
                    <TextBlock Text="{DynamicResource String.Java.Preference}" Style="{StaticResource Text.Caption}" Margin="0,16,0,6"/>
                    <ComboBox x:Name="JavaPreferenceCombo" SelectionChanged="Setting_OnChanged" HorizontalAlignment="Left" Width="280">
                        <ComboBoxItem Content="{DynamicResource String.Java.PreferJdk}"/>
                        <ComboBoxItem Content="{DynamicResource String.Java.PreferJre}"/>
                    </ComboBox>
                    <TextBlock Text="{DynamicResource String.Java.PreferenceHint}" Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"/>

                    <!-- 失败策略 -->
                    <TextBlock Text="{DynamicResource String.Java.OnFailure}" Style="{StaticResource Text.Caption}" Margin="0,16,0,6"/>
                    <ComboBox x:Name="JavaFailureCombo" SelectionChanged="Setting_OnChanged" HorizontalAlignment="Left" Width="280">
                        <ComboBoxItem Content="{DynamicResource String.Java.FailureRetry}"/>
                        <ComboBoxItem Content="{DynamicResource String.Java.FailureThrow}"/>
                    </ComboBox>
                    <TextBlock Text="{DynamicResource String.Java.FailureHint}" Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource String.Java.MaxRetries}" VerticalAlignment="Center"
                                   Style="{StaticResource Text.Caption}" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1" x:Name="JavaRetriesBox" LostFocus="Setting_OnChanged"/>
                    </Grid>

                    <Separator Margin="0,18,0,14" Background="{DynamicResource Brush.Border}" Height="1"/>

                    <TextBlock Text="{DynamicResource String.Settings.JavaPathHint}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="JavaPathBox" LostFocus="Setting_OnChanged"/>
                        <Button Grid.Column="1" Style="{StaticResource Button.Base}" Content="{DynamicResource String.Settings.BrowseJava}" Margin="10,0,0,0" Padding="16,8" Click="BrowseJava_OnClick"/>
                        <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Content="{DynamicResource String.Java.AddByPath}" Margin="8,0,0,0" Padding="14,8" Click="AddJavaPath_OnClick"/>
                    </Grid>
                    <CheckBox x:Name="AutoJavaCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.AutoDetectJava}" Margin="0,12,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <CheckBox x:Name="AutoRuntimeCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.AutoRuntime}" Margin="0,10,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <CheckBox x:Name="AutoMemoryCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.AutoMemory}" Margin="0,14,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource String.Settings.MinMemory}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="MinMemoryBox" LostFocus="Setting_OnChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource String.Settings.MaxMemory2}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="MaxMemoryBox" LostFocus="Setting_OnChanged"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{DynamicResource String.Settings.MemoryRatio}" Style="{StaticResource Text.Caption}" Margin="0,12,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="60"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" x:Name="MemoryRatioSlider" Minimum="0.05" Maximum="0.9" TickFrequency="0.05"
                                IsSnapToTickEnabled="True" ValueChanged="Setting_OnChanged"/>
                        <TextBlock Grid.Column="1" x:Name="MemoryRatioText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource String.Settings.JvmArgs}" Style="{StaticResource Text.Caption}" Margin="0,12,0,6"/>
                    <TextBox x:Name="JvmArgsBox" LostFocus="Setting_OnChanged" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                    <TextBlock Text="{DynamicResource String.Settings.EnvVars}" Style="{StaticResource Text.Caption}" Margin="0,12,0,6"/>
                    <TextBox x:Name="EnvBox" LostFocus="Setting_OnChanged" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                    <TextBlock Text="{DynamicResource String.Settings.ProcessPriority}" Style="{StaticResource Text.Caption}" Margin="0,12,0,6"/>
                    <ComboBox x:Name="PriorityCombo" SelectionChanged="Setting_OnChanged" HorizontalAlignment="Left" Width="180">
                        <ComboBoxItem Content="Idle"/>
                        <ComboBoxItem Content="BelowNormal"/>
                        <ComboBoxItem Content="Normal"/>
                        <ComboBoxItem Content="AboveNormal"/>
                        <ComboBoxItem Content="High"/>
                    </ComboBox>

                    <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="0,16,0,14"/>
                    <TextBlock Text="{DynamicResource String.Download.JavaHint}" Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap"/>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="JavaComponentCombo">
                            <ComboBoxItem Content="java-runtime-gamma (Java 21)" IsSelected="True"/>
                            <ComboBoxItem Content="java-runtime-alpha (Java 17)"/>
                            <ComboBoxItem Content="jre-legacy (Java 8)"/>
                        </ComboBox>
                        <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Content="{DynamicResource String.Download.DownloadRuntime}"
                                Margin="12,0,0,0" Padding="22,10" Click="DownloadJavaRuntime_OnClick"/>
                    </Grid>
                    <TextBlock x:Name="JavaRuntimeStatusText" Text="" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Expander>

            <!-- 启动 -->
            <Expander Header="{DynamicResource String.Settings.GroupLaunch}" Style="{StaticResource SettingsGroup}" Tag="launch">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource String.Settings.WindowWidth}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="WidthBox" LostFocus="Setting_OnChanged"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource String.Settings.WindowHeight}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                            <TextBox x:Name="HeightBox" LostFocus="Setting_OnChanged"/>
                        </StackPanel>
                    </Grid>
                    <CheckBox x:Name="FullscreenCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.Fullscreen}" Margin="0,14,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <TextBlock Text="{DynamicResource String.Settings.AfterLaunch}" Style="{StaticResource Text.Caption}" Margin="0,14,0,6"/>
                    <ComboBox x:Name="AfterLaunchCombo" SelectionChanged="Setting_OnChanged" HorizontalAlignment="Left" Width="220">
                        <ComboBoxItem Content="{DynamicResource String.Settings.AfterKeepOpen}" Tag="0"/>
                        <ComboBoxItem Content="{DynamicResource String.Settings.AfterHide}" Tag="1"/>
                        <ComboBoxItem Content="{DynamicResource String.Settings.AfterExit}" Tag="2"/>
                    </ComboBox>
                    <TextBlock Text="{DynamicResource String.Settings.GameArgs}" Style="{StaticResource Text.Caption}" Margin="0,12,0,6"/>
                    <TextBox x:Name="GameArgsBox" LostFocus="Setting_OnChanged"/>
                    <TextBlock Text="{DynamicResource String.Settings.QuickJoinServer}" Style="{StaticResource Text.Caption}" Margin="0,12,0,6"/>
                    <TextBox x:Name="ServerBox" LostFocus="Setting_OnChanged"/>
                    <TextBlock Text="{DynamicResource String.Settings.QuickJoinWorld}" Style="{StaticResource Text.Caption}" Margin="0,12,0,6"/>
                    <TextBox x:Name="WorldBox" LostFocus="Setting_OnChanged"/>
                    <CheckBox x:Name="CheckBeforeLaunchCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.CheckBeforeLaunch}" Margin="0,10,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <CheckBox x:Name="AutoDownloadMissingCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.AutoDownloadMissing}" Margin="0,10,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <CheckBox x:Name="CustomTitleCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.CustomTitle}" Margin="0,10,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <TextBox x:Name="CustomTitleBox" Margin="0,8,0,0" LostFocus="Setting_OnChanged"/>
                </StackPanel>
            </Expander>

            <!-- 外观 -->
            <Expander Header="{DynamicResource String.Settings.GroupAppearance}" Style="{StaticResource SettingsGroup}" Tag="appearance">
                <StackPanel>
                    <!-- 性能模式：放最上面，因为它会覆盖下面的毛玻璃 / 模糊 / 动效 -->
                    <TextBlock Text="{DynamicResource String.Settings.PerformanceMode}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="PerformanceCombo" SelectionChanged="PerformanceMode_OnChanged" HorizontalAlignment="Left" Width="240">
                        <ComboBoxItem Content="{DynamicResource String.Settings.PerformanceStandard}" Tag="0"/>
                        <ComboBoxItem Content="{DynamicResource String.Settings.PerformanceSmooth}" Tag="1"/>
                    </ComboBox>
                    <TextBlock Text="{DynamicResource String.Settings.PerformanceHint}" Style="{StaticResource Text.Caption}"
                               FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <!-- 启动器窗口标题 -->
                    <TextBlock Text="{DynamicResource String.Settings.LauncherTitle}" Style="{StaticResource Text.Caption}" Margin="0,12,0,6"/>
                    <TextBox x:Name="LauncherTitleBox" LostFocus="LauncherTitle_OnLostFocus" Width="240" HorizontalAlignment="Left"/>
                    <TextBlock Text="{DynamicResource String.Settings.LauncherTitleHint}" Style="{StaticResource Text.Caption}"
                               FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <TextBlock Text="{DynamicResource String.Settings.Theme}" Style="{StaticResource Text.Caption}" Margin="0,12,0,6"/>
                    <ComboBox x:Name="ThemeCombo" SelectionChanged="Setting_OnChanged" HorizontalAlignment="Left" Width="200">
                        <ComboBoxItem Content="{DynamicResource String.Settings.ThemeSystem}" Tag="0"/>
                        <ComboBoxItem Content="{DynamicResource String.Settings.ThemeLight}" Tag="1"/>
                        <ComboBoxItem Content="{DynamicResource String.Settings.ThemeDark}" Tag="2"/>
                    </ComboBox>
                    <TextBlock Text="{DynamicResource String.Settings.Backdrop}" Style="{StaticResource Text.Caption}" Margin="0,12,0,6"/>
                    <ComboBox x:Name="BackdropCombo" SelectionChanged="Setting_OnChanged" HorizontalAlignment="Left" Width="240">
                        <ComboBoxItem Content="{DynamicResource String.Settings.BackdropNone}" Tag="0"/>
                        <ComboBoxItem Content="Mica" Tag="1"/>
                        <ComboBoxItem Content="{DynamicResource String.Settings.BackdropAcrylic}" Tag="2"/>
                        <ComboBoxItem Content="{DynamicResource String.Settings.BackdropBlur}" Tag="3"/>
                    </ComboBox>
                    <TextBlock Text="{DynamicResource String.Settings.BackdropOpacity}" Style="{StaticResource Text.Caption}" Margin="0,12,0,6"/>
                    <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1" TickFrequency="0.02" IsSnapToTickEnabled="True" ValueChanged="Setting_OnChanged"/>
                    <TextBlock Text="{DynamicResource String.Settings.BackgroundImage}" Style="{StaticResource Text.Caption}" Margin="0,12,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" x:Name="BackgroundBox" LostFocus="Setting_OnChanged"/>
                        <Button Grid.Column="1" Style="{StaticResource Button.Base}" Content="{DynamicResource String.Settings.Choose}" Margin="10,0,0,0" Padding="16,8" Click="BrowseBackground_OnClick"/>
                        <Button Grid.Column="2" Style="{StaticResource Button.Base}" Content="{DynamicResource String.Settings.Clear}" Margin="8,0,0,0" Padding="16,8" Click="ClearBackground_OnClick"/>
                    </Grid>
                    <!-- 背景图透明度 -->
                    <TextBlock Text="{DynamicResource String.Settings.BackgroundOpacity}" Style="{StaticResource Text.Caption}" Margin="0,12,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" x:Name="BackgroundOpacitySlider" Minimum="0.05" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                ValueChanged="BackgroundOpacity_OnChanged"/>
                        <TextBlock Grid.Column="1" x:Name="BackgroundOpacityText" Text="35%" Width="46" TextAlignment="Right" FontSize="11.5"
                                   Foreground="{DynamicResource Brush.ForegroundMuted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource String.Settings.BackgroundOpacityHint}" Style="{StaticResource Text.Caption}"
                               FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0"/>

                    <!-- 填充方式 -->
                    <TextBlock Text="{DynamicResource String.Settings.BackgroundStretch}" Style="{StaticResource Text.Caption}" Margin="0,12,0,6"/>
                    <ComboBox x:Name="BackgroundStretchCombo" Style="{StaticResource ComboBox.Glass}" Width="200" HorizontalAlignment="Left"
                              SelectionChanged="BackgroundStretch_OnChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text, Mode=OneWay}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="{DynamicResource String.Settings.BackgroundBlur}" Style="{StaticResource Text.Caption}" Margin="0,12,0,6"/>
                    <Slider x:Name="BlurSlider" Minimum="0" Maximum="100" TickFrequency="2" IsSnapToTickEnabled="True" ValueChanged="Setting_OnChanged"/>
                    <TextBlock Text="{DynamicResource String.Settings.AccentColor}" Style="{StaticResource Text.Caption}" Margin="0,12,0,6"/>
                    <TextBox x:Name="AccentBox" LostFocus="Setting_OnChanged" Width="160" HorizontalAlignment="Left"/>
                    <CheckBox x:Name="AnimationCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.EnableAnimations}" Margin="0,14,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <CheckBox x:Name="StretchCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.EnableStretch}" Margin="0,10,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <TextBlock Text="{DynamicResource String.Settings.AnimationDuration}" Style="{StaticResource Text.Caption}" Margin="0,12,0,6"/>
                    <TextBox x:Name="AnimationDurationBox" LostFocus="Setting_OnChanged" Width="160" HorizontalAlignment="Left"/>
                    <TextBlock Text="{DynamicResource String.Settings.CornerRadius}" Style="{StaticResource Text.Caption}" Margin="0,12,0,6"/>
                    <Slider x:Name="CornerSlider" Minimum="0" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Setting_OnChanged"/>
                </StackPanel>
            </Expander>

            <!-- 隐私与日志监听 -->
            <Expander Header="{DynamicResource String.Settings.GroupPrivacy}" Style="{StaticResource SettingsGroup}" Tag="privacy">
                <StackPanel>
                    <CheckBox x:Name="LogMonitorCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.EnableMonitor}"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <CheckBox x:Name="LogWindowCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.DebugLogWindow}" Margin="0,10,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <CheckBox x:Name="NotifyPortCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.NotifyPort}" Margin="0,10,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <CheckBox x:Name="NotifyCrashCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.NotifyCrash}" Margin="0,10,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <CheckBox x:Name="ShowLogOnCrashCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.ShowLogOnCrash}" Margin="0,10,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <CheckBox x:Name="SaveGameLogCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.SaveGameLog}" Margin="0,10,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <TextBlock Text="{DynamicResource String.Settings.MonitorOffHint}"
                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                </StackPanel>
            </Expander>

            <!-- 高级 -->
            <Expander Header="{DynamicResource String.Settings.GroupAdvanced}" Style="{StaticResource SettingsGroup}" Tag="advanced">
                <StackPanel>
                    <TextBlock x:Name="LanguageLabel" Text="{DynamicResource String.Settings.Language}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="LanguageCombo" SelectionChanged="LanguageCombo_OnSelectionChanged" HorizontalAlignment="Left" Width="200">
                        <ComboBoxItem Content="{DynamicResource String.Settings.LanguageZhHans}"/>
                        <ComboBoxItem Content="English"/>
                    </ComboBox>
                    <TextBlock Text="{DynamicResource String.Settings.LogLevel}" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                    <ComboBox x:Name="LogLevelCombo" SelectionChanged="Setting_OnChanged" HorizontalAlignment="Left" Width="200">
                        <ComboBoxItem Content="Debug" Tag="0"/>
                        <ComboBoxItem Content="Info" Tag="1"/>
                        <ComboBoxItem Content="Warn" Tag="2"/>
                        <ComboBoxItem Content="Error" Tag="3"/>
                    </ComboBox>
                    <CheckBox x:Name="CheckUpdateCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.CheckUpdate}" Margin="0,14,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <CheckBox x:Name="DevModeCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.DevMode}" Margin="0,10,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <CheckBox x:Name="ShowAdvancedCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.ShowAdvanced}" Margin="0,10,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <CheckBox x:Name="AutoRefreshAccountCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.AutoRefreshAccount}" Margin="0,10,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <CheckBox x:Name="GuardEnableCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.GuardEnable}" Margin="0,10,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <TextBlock Text="{DynamicResource String.Settings.GuardHint}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{DynamicResource String.Settings.GuardTimeout}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center"/>
                        <TextBox x:Name="GuardTimeoutBox" Width="64" Margin="10,0,0,0" TextChanged="Setting_OnChanged"/>
                        <TextBlock Text="s" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="GuardAutoKillCheck" Style="{StaticResource Switch}" Content="{DynamicResource String.Settings.GuardAutoKill}" Margin="0,10,0,0"
                              Checked="Setting_OnChanged" Unchecked="Setting_OnChanged"/>
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Settings.ExportSettings}" Padding="16,8" Click="Export_OnClick"/>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Settings.ImportSettings}" Margin="10,0,0,0" Padding="16,8" Click="Import_OnClick"/>
                        <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.Settings.ResetDefault}" Margin="10,0,0,0" Padding="16,8" Click="Reset_OnClick"/>
                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
