<Window x:Class="LPML.App.Windows.UpdateWindow" Closing="Window_OnClosing"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LPML" Width="740" Height="640" MinWidth="580" MinHeight="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{DynamicResource Font.Ui}">
    <Border Background="{DynamicResource Brush.Window}" CornerRadius="{DynamicResource Radius.Card}"
            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
        <Grid Margin="26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题行 -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⬆" FontSize="22" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource Brush.Accent}"/>
                    <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Border Margin="12,0,0,0" Padding="8,3" CornerRadius="8" VerticalAlignment="Center"
                            Background="{DynamicResource Brush.AccentSoft}">
                        <TextBlock x:Name="LevelText" FontSize="11" Foreground="{DynamicResource Brush.Accent}"/>
                    </Border>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="0,8,0,14">
                <TextBlock x:Name="MetaText" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.ForegroundMuted}"/>
                <TextBlock Text="{DynamicResource String.Update.VerifyHint}" FontSize="11" TextWrapping="Wrap"
                           Margin="0,4,0,0" Foreground="{DynamicResource Brush.ForegroundMuted}"/>
            </StackPanel>

            <!-- 更新说明（Markdown 正文） -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,10">
                <FlowDocumentScrollViewer x:Name="DocViewer" Background="Transparent"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          IsToolBarVisible="False" IsSelectionEnabled="True"/>
            </Border>

            <!-- 下载线路 -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource String.Update.LineLabel}"
                           VerticalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                <ComboBox Grid.Column="1" x:Name="LineCombo" Margin="12,0,0,0"
                          HorizontalAlignment="Left" Width="260">
                    <ComboBoxItem Content="{DynamicResource String.Update.LineAuto}"/>
                    <ComboBoxItem Content="{DynamicResource String.Update.LineDirect}"/>
                    <ComboBoxItem Content="{DynamicResource String.Update.LineProxy}"/>
                </ComboBox>
            </Grid>

            <!-- 更新包类型：自动跟随当前安装，也可手动换 -->
            <StackPanel Grid.Row="4" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource String.Update.PackageLabel}"
                               VerticalAlignment="Center" Style="{StaticResource Text.Caption}"/>
                    <ComboBox Grid.Column="1" x:Name="PackageCombo" Margin="12,0,0,0"
                              HorizontalAlignment="Left" Width="260"
                              SelectionChanged="Package_OnChanged">
                        <ComboBoxItem Content="{DynamicResource String.Update.PackageAuto}"/>
                        <ComboBoxItem Content="{DynamicResource String.Settings.UpdatePackageRuntime}"/>
                        <ComboBoxItem Content="{DynamicResource String.Settings.UpdatePackageNoRuntime}"/>
                    </ComboBox>
                </Grid>
                <TextBlock x:Name="RuntimeInfoText" FontSize="11" TextWrapping="Wrap"
                           Margin="0,4,0,0" Foreground="{DynamicResource Brush.ForegroundMuted}"/>
            </StackPanel>

            <!-- 状态与进度 -->
            <StackPanel Grid.Row="5" Margin="0,12,0,0">
                <TextBlock x:Name="StatusText" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.ForegroundSecondary}"/>
                <Border x:Name="ProgressTrack" Height="6" Margin="0,8,0,0" Visibility="Collapsed"
                        Background="{DynamicResource Brush.Card}" CornerRadius="3">
                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0"
                            Background="{DynamicResource Brush.Accent}" CornerRadius="3"/>
                </Border>
            </StackPanel>

            <!-- 按钮 -->
            <Grid Grid.Row="6" Margin="0,18,0,0">
                <TextBlock x:Name="MandatoryHint" VerticalAlignment="Center" FontSize="11"
                           TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{DynamicResource Brush.ForegroundMuted}"
                           Text="{DynamicResource String.Update.MandatoryHint}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ReleaseButton" Style="{StaticResource Button.Base}" Padding="16,8"
                            Content="{DynamicResource String.Update.ReleasePage}" Click="Release_OnClick"/>
                    <Button x:Name="LaterButton" Style="{StaticResource Button.Base}" Padding="18,8"
                            Margin="10,0,0,0" Content="{DynamicResource String.Update.Later}" Click="Later_OnClick"/>
                    <Button x:Name="UpdateButton" Style="{StaticResource Button.Primary}" Padding="20,8"
                            Margin="10,0,0,0" Content="{DynamicResource String.Update.UpdateNow}" Click="Update_OnClick"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
