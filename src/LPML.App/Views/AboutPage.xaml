<UserControl x:Class="LPML.App.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource Font.Ui}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,20,28,28">
            <TextBlock Text="{DynamicResource String.About.Title}" Style="{StaticResource Text.Title}"/>
            <TextBlock Text="{DynamicResource String.About.Subtitle}" Style="{StaticResource Text.Subtitle}" Margin="0,4,0,20"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="64" Height="64" CornerRadius="18" Background="{DynamicResource Brush.Accent}">
                            <TextBlock Text="L" FontSize="30" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LPML" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource String.About.FullName}" Style="{StaticResource Text.Subtitle}" Margin="0,2,0,0"/>
                            <TextBlock Text="{DynamicResource String.About.Version}" Style="{StaticResource Text.Subtitle}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String.About.PortableTitle}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Text.Subtitle}">
                        · 所有配置、缓存、日志都写入启动器所在目录，不写系统盘、不写注册表、不写 AppData。
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Text.Subtitle}" Margin="0,6,0,0">
                        · 默认完全不使用系统 TEMP；你可以手动开启，并可设置写入量上限，退出时自动清理。
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Text.Subtitle}" Margin="0,6,0,0">
                        · 游戏目录采用官方 .minecraft 结构，可与官方启动器 / HMCL / PCL 互通。
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource Text.Subtitle}" Margin="0,6,0,0">
                        · 无任何遥测，账户令牌只保存在本机 config\accounts.json。
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource String.About.DataLocation}" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource String.About.RootDir}" Style="{StaticResource Text.Caption}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="RootText" FontSize="12"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource String.About.GameDir}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="GameText" FontSize="12" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource String.About.CacheDir}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CacheText" FontSize="12" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource String.About.LogDir}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LogText" FontSize="12" Margin="0,8,0,0"/>
                    </Grid>
                    <Button Style="{StaticResource Button.Base}" Content="{DynamicResource String.About.OpenRoot}" Margin="0,14,0,0" Padding="18,9"
                            HorizontalAlignment="Left" Click="OpenRoot_OnClick"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
